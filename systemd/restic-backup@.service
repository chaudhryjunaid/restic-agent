# Template service: one instance per job, e.g. restic-backup@home.service.
# Installed by "resticagent install"; the timer of the same name starts it.
# Run without root, install adds it as a user unit instead, with the program
# and settings paths below changed to the user's own.
[Unit]
Description=restic backup job %i
Documentation=https://restic.readthedocs.io/
# Wait for the network so remote repositories (sftp, s3, rest) are reachable.
# User units cannot see this system target, so they start without waiting.
Wants=network-online.target
After=network-online.target
# Skip silently if the job has been removed but the timer is still around.
ConditionPathExists=/etc/resticagent/config.d/%i/env
# A failed run starts the job's alert: a desktop notification and local mail.
OnFailure=restic-backup-notify@%i.service

[Service]
Type=oneshot
# The script loads /etc/resticagent/config and config.d/%i/env itself, so a
# manual "resticagent run %i" behaves like a timer run. --notify adds desktop
# notices when the run starts and succeeds.
ExecStart=/usr/local/bin/resticagent run %i --notify
# Backups are I/O heavy; keep them out of the way of interactive work.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Left out of user units, where it needs user namespaces.
PrivateTmp=true
