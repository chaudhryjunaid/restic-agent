#!/usr/bin/env bash
#
# resticagent - manage restic backups as systemd services and timers.
#
# Run by a regular user, it manages that user's own backups with the user's
# systemd manager (systemctl --user) and needs no root. Run as root, or with
# --system, it manages the system-wide backups with the system manager:
#
#                as a regular user          as root or with --system
#   settings     ~/.config/resticagent      /etc/resticagent
#   unit files   ~/.config/systemd/user     /etc/systemd/system
#   program      ~/.local/bin/resticagent   /usr/local/bin/resticagent
#
# ~/.config stands for $XDG_CONFIG_HOME when that is set. The settings
# directory lives outside this repository, on the host:
#   config                  global settings shared by every job
#   config.d/<job>/env      job settings: schedule, retention, options
#   config.d/<job>/src      paths to back up, one per line
#   config.d/<job>/exclude  patterns to skip, one per line
#
# "install" copies this script to the program path, with the unit templates
# from ../systemd next to it in ../share/resticagent/systemd (setup.sh installs
# the same layout), and puts these in the unit directory:
#   restic-backup@.service                    unit templates,
#   restic-backup@.timer                      with this scope's paths
#   restic-backup@<job>.timer.d/schedule.conf per-job schedule
#
# Set RESTICAGENT_ROOT to a directory to prefix every path above (development
# and tests). Root is then not needed, also not with --system. For system
# units, enable and disable act on the files below that directory; systemctl
# cannot do that for user units. Other state-changing systemctl calls are only
# printed, and read-only queries (show, status, journalctl) still go to the host.

set -euo pipefail

VERSION="0.7.0"
ROOT="${RESTICAGENT_ROOT:-}"
ROOT=${ROOT%/}
UNIT_PREFIX="restic-backup@"
# restic 0.17 added the exit codes (10 = no repository, 12 = wrong password)
# that install relies on, and --retry-lock (0.16) is used by run.
MIN_RESTIC_MINOR=17
KEEP_RULES=(last hourly daily weekly monthly yearly within)
# The keys of a job's env file that "add" asks about, besides the repository
# and password file overrides, in the order they are written.
JOB_KEYS=(ON_CALENDAR RANDOMIZED_DELAY KEEP_LAST KEEP_HOURLY KEEP_DAILY KEEP_WEEKLY
          KEEP_MONTHLY KEEP_YEARLY KEEP_WITHIN BACKUP_TAGS ONE_FILE_SYSTEM PRUNE)
# Message IDs systemd logs when a start job ends: successfully, or failed.
MSG_UNIT_STARTED=39f53479d3a045ac8e11786248231fbf
MSG_UNIT_FAILED=be02cf6855d2428ba40df7e9d022f03d
PROG=$(basename "$0")
SELF=$(readlink -f "${BASH_SOURCE[0]}")
# Tools installed next to the program, such as the restic that setup.sh puts
# in ~/.local/bin, come first. systemd's PATH does not include ~/.local/bin.
PATH="${SELF%/*}:$PATH"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_RESET=$'\e[0m'
else
  C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_RESET=''
fi

info()   { printf '%s\n' "$*"; }
note()   { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
ok()     { printf '%s+%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn()   { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()    { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
header() { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
row()    { printf '  %-20s %s\n' "$1" "$2"; }

# ---------------------------------------------------------------------------
# Scope: the jobs of the user running this, or the system-wide jobs
# ---------------------------------------------------------------------------

# set_scope user|system -> the paths and the systemd manager the jobs use
set_scope() {
  SCOPE=$1
  local config_home
  if [[ "$SCOPE" == system ]]; then
    CONFIG_DIR="$ROOT/etc/resticagent"
    SYSTEMD_DIR="$ROOT/etc/systemd/system"
    BIN_PATH="$ROOT/usr/local/bin/resticagent"
    DEFAULT_CACHE_DIR=/var/cache/restic
    JOURNAL_UNIT=-u
    # Hints spell out the commands to run; system-wide jobs need sudo.
    SUDO='sudo '
  else
    [[ -n "${HOME:-}" ]] || die "HOME is not set, so there is no place for your settings"
    config_home=${XDG_CONFIG_HOME:-$HOME/.config}
    CONFIG_DIR="$ROOT$config_home/resticagent"
    SYSTEMD_DIR="$ROOT$config_home/systemd/user"
    BIN_PATH="$ROOT$HOME/.local/bin/resticagent"
    DEFAULT_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/restic
    # Unlike "journalctl --user -u", this searches every journal the user may
    # read, so it also works where journald keeps one shared journal (without
    # persistent storage) and the user is in the adm or systemd-journal group.
    JOURNAL_UNIT=--user-unit
    SUDO=''
  fi
  GLOBAL_CONFIG="$CONFIG_DIR/config"
  JOBS_DIR="$CONFIG_DIR/config.d"
  # The installed program's data, e.g. ~/.local/share/resticagent next to ~/.local/bin
  SHARE_DIR="${BIN_PATH%/bin/resticagent}/share/resticagent"
}

if (( EUID == 0 )); then set_scope system; else set_scope user; fi

# sctl ARGS... -> systemctl, talking to the manager that runs the jobs
sctl() { systemctl "--$SCOPE" "$@"; }

# Only system-wide jobs need root; users manage their own jobs without it.
require_root() {
  [[ -n "$ROOT" || "$SCOPE" == user ]] && return 0
  [[ $EUID -eq 0 ]] || die "system-wide jobs need root. Try: $SUDO$PROG $*"
}

# system_jobs_hint -> for a user without jobs of their own, a pointer to the
# system-wide jobs, which a regular user no longer sees by default
system_jobs_hint() {
  [[ "$SCOPE" == user ]] || return 0
  if compgen -G "$ROOT/etc/resticagent/config.d/*/" >/dev/null; then
    note "  This host has system-wide jobs. See them with: $PROG --system status"
  fi
}

# ---------------------------------------------------------------------------
# Prompt helpers
# ---------------------------------------------------------------------------

# read_line VAR PROMPT [PREFILL]
# On a terminal the input line is pre-filled with PREFILL and edited in place,
# so clearing the line unsets an optional value. Without a terminal (piped
# input) the default is shown in brackets and an empty answer selects it.
read_line() {
  local -n _rl_out=$1
  local _rl_prompt=$2 _rl_prefill=${3:-}
  if [[ -t 0 ]]; then
    read -r -e -i "$_rl_prefill" -p "$_rl_prompt" _rl_out
  else
    printf '%s%s' "$_rl_prompt" "${_rl_prefill:+[$_rl_prefill] }"
    read -r _rl_out || return 1
    [[ -z "$_rl_out" && -n "$_rl_prefill" ]] && _rl_out=$_rl_prefill
    printf '%s\n' "$_rl_out"
  fi
}

# ask VAR PROMPT DEFAULT [VALIDATOR]
# Re-prompts until VALIDATOR (a function name) accepts the answer. After a
# rejected answer the line is pre-filled with what was typed so it can be fixed.
ask() {
  local -n _ask_out=$1
  local _ask_prompt=$2 _ask_default=${3:-} _ask_validator=${4:-validate_value} _ask_value
  while true; do
    read_line _ask_value "$_ask_prompt: " "$_ask_default" || die "aborted"
    if "$_ask_validator" "$_ask_value"; then
      _ask_out=$_ask_value
      return 0
    fi
    _ask_default=$_ask_value
  done
}

# ask_yesno PROMPT DEFAULT(y|n) -> returns 0 for yes, 1 for no
ask_yesno() {
  local _yn_prompt=$1 _yn_default=$2 _yn_value _yn_hint
  [[ $_yn_default == y ]] && _yn_hint='Y/n' || _yn_hint='y/N'
  while true; do
    if [[ -t 0 ]]; then
      read -r -p "$_yn_prompt [$_yn_hint]: " _yn_value || die "aborted"
    else
      printf '%s' "$_yn_prompt [$_yn_hint]: "
      read -r _yn_value || die "aborted"
      printf '%s\n' "${_yn_value:-$_yn_default}"
    fi
    _yn_value=${_yn_value:-$_yn_default}
    case ${_yn_value,,} in
      y|yes) return 0 ;;
      n|no)  return 1 ;;
      *)     warn "please answer y or n" ;;
    esac
  done
}

yn_default() { [[ "$1" == 1 ]] && echo y || echo n; }

# ask_list ARRAY TITLE HINT [VALIDATOR]
# ARRAY may already hold the current entries; the user keeps or replaces them.
# New entries are read one per line until an empty line.
ask_list() {
  local -n _al_arr=$1
  local _al_title=$2 _al_hint=$3 _al_validator=${4:-validate_value} _al_line _al_i
  info "$_al_title"
  if (( ${#_al_arr[@]} > 0 )); then
    for _al_i in "${!_al_arr[@]}"; do
      printf '  %2d  %s\n' "$((_al_i + 1))" "${_al_arr[$_al_i]}"
    done
    if ask_yesno "Keep these ${#_al_arr[@]} entries?" y; then
      return 0
    fi
    _al_arr=()
  fi
  note "$_al_hint"
  note "One per line. Leave the line empty to finish."
  while true; do
    read_line _al_line "$(printf '  %2d> ' "$(( ${#_al_arr[@]} + 1 ))")" "" || break
    [[ -n "$_al_line" ]] || break
    if "$_al_validator" "$_al_line"; then
      _al_arr+=("$_al_line")
    fi
  done
}

# ---------------------------------------------------------------------------
# Validators: return 0 to accept, or print a hint and return 1 to re-prompt
# ---------------------------------------------------------------------------

# Every value is stored as KEY='VALUE'. Bash and systemd (EnvironmentFile=)
# agree on single-quoted strings except for the single quote and the
# backslash, so those two characters are refused everywhere.
validate_value() {
  case $1 in
    *\'*|*\\*) warn "single quotes and backslashes are not allowed"; return 1 ;;
  esac
}

validate_required() {
  [[ -n "$1" ]] || { warn "a value is required"; return 1; }
  validate_value "$1"
}

validate_job_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { warn "use letters, digits, '-' and '_' only"; return 1; }
}

validate_abs_path() {
  [[ "$1" == /* ]] || { warn "enter an absolute path starting with /"; return 1; }
  validate_value "$1"
}

validate_abs_path_or_empty() {
  [[ -z "$1" ]] || validate_abs_path "$1"
}

validate_src_path() {
  validate_abs_path "$1" || return 1
  [[ -e "$1" ]] || warn "$1 does not exist on this host (kept anyway)"
}

validate_int_or_empty() {
  [[ -z "$1" || "$1" =~ ^[0-9]+$ ]] || { warn "enter a whole number or leave empty"; return 1; }
}

validate_restic_duration_or_empty() {
  [[ -z "$1" || "$1" =~ ^([0-9]+[ymdh])+$ ]] || { warn "use restic durations such as 30d, 2m or 1y6m, or leave empty"; return 1; }
}

validate_compression() {
  [[ "$1" =~ ^(auto|off|max)$ ]] || { warn "choose auto, off or max"; return 1; }
}

validate_calendar() {
  validate_required "$1" || return 1
  command -v systemd-analyze >/dev/null 2>&1 || return 0
  local parsed
  if ! parsed=$(systemd-analyze calendar -- "$1" 2>/dev/null); then
    warn "systemd rejects that OnCalendar expression. Examples: daily, hourly, 'Mon..Fri 18:00', '*-*-* 02:00:00'"
    return 1
  fi
  note "  next run: $(sed -n 's/^ *Next elapse: //p' <<<"$parsed")"
}

validate_timespan() {
  validate_value "$1" || return 1
  [[ -n "$1" ]] || return 0
  command -v systemd-analyze >/dev/null 2>&1 || return 0
  systemd-analyze timespan -- "$1" >/dev/null 2>&1 || { warn "systemd rejects that time span. Examples: 0, 30min, 1h"; return 1; }
}

validate_key_value() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*=.+$ ]] || { warn "enter KEY=VALUE"; return 1; }
  validate_value "${1#*=}"
}

# ---------------------------------------------------------------------------
# Config file helpers
# ---------------------------------------------------------------------------
declare -A CUR=()    # one env file, used by the init and add prompts
declare -A JENV=()   # a job's effective environment: global config + job env

# read_env ARRAY FILE -> adds KEY=VALUE from each KEY='VALUE' line of FILE.
# Parsing instead of sourcing means a config file can never run code.
read_env() {
  local -n _re_arr=$1
  local _re_file=$2 _re_line
  [[ -f "$_re_file" ]] || return 0
  while IFS= read -r _re_line || [[ -n "$_re_line" ]]; do
    if [[ "$_re_line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\'(.*)\'$ ]]; then
      # _re_arr is an associative array, so the key must be expanded.
      # shellcheck disable=SC2004
      _re_arr[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
    fi
  done <"$_re_file"
}

load_env() { CUR=(); read_env CUR "$1"; }

# load_job_env JOB -> JENV holds the global settings overridden by the job's
load_job_env() {
  JENV=()
  read_env JENV "$GLOBAL_CONFIG"
  read_env JENV "$JOBS_DIR/$1/env"
}

export_job_env() {
  local key
  for key in "${!JENV[@]}"; do export "$key=${JENV[$key]}"; done
}

# load_lines ARRAY FILE -> the non-empty, non-comment lines of FILE
load_lines() {
  local -n _ll_arr=$1
  local file=$2 line
  _ll_arr=()
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    _ll_arr+=("$line")
  done <"$file"
}

# env_line KEY VALUE -> prints KEY='VALUE'; prints nothing for an empty VALUE
env_line() {
  [[ -n "$2" ]] || return 0
  printf "%s='%s'\n" "$1" "$2"
}

# list_jobs -> the configured job names, one per line
list_jobs() {
  local dir name
  for dir in "$JOBS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    dir=${dir%/}
    name=${dir##*/}
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && printf '%s\n' "$name"
  done
  return 0
}

# write_file DEST MODE  (content on stdin)
# Touches DEST only when the content differs, so re-runs are no-ops.
# Sets WRITE_CHANGED for this call and ANY_CHANGED for the whole command.
# Call it with input redirection, not at the end of a pipe: a pipe runs it in
# a subshell and the two flags would be lost.
WRITE_CHANGED=0
ANY_CHANGED=0
write_file() {
  local dest=$1 mode=$2 tmp
  tmp=$(mktemp)
  cat >"$tmp"
  WRITE_CHANGED=1
  if [[ -f "$dest" ]] && cmp -s "$tmp" "$dest"; then
    chmod "$mode" "$dest"
    info "  unchanged  $dest"
    WRITE_CHANGED=0
  elif [[ -f "$dest" ]]; then
    install -m "$mode" "$tmp" "$dest"
    ok "updated    $dest"
  else
    install -D -m "$mode" "$tmp" "$dest"
    ok "created    $dest"
  fi
  rm -f "$tmp"
  if (( WRITE_CHANGED )); then ANY_CHANGED=1; fi
  return 0
}

# ensure_password_file PATH -> offers to create a missing restic password file
ensure_password_file() {
  local file=$1 p1 p2
  [[ -n "$file" && ! -e "$file" ]] || return 0
  warn "password file $file does not exist"
  if ! ask_yesno "Create it now?" y; then
    warn "create $file (mode 0600) before the first backup"
    return 0
  fi
  while true; do
    read -r -s -p "Repository password: " p1 || die "aborted"; printf '\n'
    read -r -s -p "Repeat password: " p2 || die "aborted"; printf '\n'
    [[ -n "$p1" && "$p1" == "$p2" ]] && break
    warn "passwords are empty or do not match"
  done
  mkdir -p "$(dirname "$file")"
  (umask 077 && printf '%s\n' "$p1" >"$file")
  ok "created    $file (mode 0600)"
}

# ---------------------------------------------------------------------------
# Writers shared by init, add and import, so every path produces the same files
# ---------------------------------------------------------------------------

# job_managed_key KEY -> true for the job keys that "add" asks about
job_managed_key() {
  case " RESTIC_REPOSITORY RESTIC_PASSWORD_FILE ${JOB_KEYS[*]} " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# sorted_keys ARRAY KEY... -> sets ARRAY to the KEYs, sorted
sorted_keys() {
  local -n _sk=$1
  shift
  _sk=()
  if (( $# > 0 )); then mapfile -t _sk < <(printf '%s\n' "$@" | sort); fi
}

# join_by SEPARATOR ITEM... -> the ITEMs joined by SEPARATOR
join_by() {
  local sep=$1 out='' item
  shift
  for item in "$@"; do out+="${out:+$sep}$item"; done
  printf '%s' "$out"
}

# write_global_config ARRAY -> writes /etc/resticagent/config from ARRAY
write_global_config() {
  local -n _wg=$1
  local key
  local -a extra=() names=()
  for key in "${!_wg[@]}"; do
    case $key in
      RESTIC_REPOSITORY|RESTIC_PASSWORD_FILE|RESTIC_CACHE_DIR|RESTIC_COMPRESSION) ;;
      *) names+=("$key") ;;
    esac
  done
  sorted_keys extra "${names[@]}"
  mkdir -p "$CONFIG_DIR"
  write_file "$GLOBAL_CONFIG" 0600 < <(
    printf '# resticagent global settings. Change them with "%s init" or "%s import --global".\n' "$PROG" "$PROG"
    printf '# Read by "%s run" before each job'"'"'s own env file.\n' "$PROG"
    for key in RESTIC_REPOSITORY RESTIC_PASSWORD_FILE RESTIC_CACHE_DIR RESTIC_COMPRESSION "${extra[@]}"; do
      env_line "$key" "${_wg[$key]:-}"
    done
  )
}

# write_job_env JOB ARRAY -> writes config.d/JOB/env from ARRAY: the repository
# overrides, the job settings, then any other variables, in a fixed order
write_job_env() {
  local job=$1 key
  local -n _wj=$2
  local -a extra=() names=()
  for key in "${!_wj[@]}"; do
    job_managed_key "$key" || names+=("$key")
  done
  sorted_keys extra "${names[@]}"
  mkdir -p "$JOBS_DIR/$job"
  write_file "$JOBS_DIR/$job/env" 0600 < <(
    printf "# resticagent job '%s'. Change it with \"%s add %s\" or \"%s import\".\n" "$job" "$PROG" "$job" "$PROG"
    printf '# Read by "%s run %s" after %s.\n' "$PROG" "$job" "${GLOBAL_CONFIG#"$ROOT"}"
    for key in RESTIC_REPOSITORY RESTIC_PASSWORD_FILE "${JOB_KEYS[@]}" "${extra[@]}"; do
      env_line "$key" "${_wj[$key]:-}"
    done
  )
}

# write_job_lists JOB SRC_ARRAY EXCLUDE_ARRAY -> writes config.d/JOB/{src,exclude}
write_job_lists() {
  local job=$1
  local -n _wl_src=$2 _wl_exclude=$3
  # src is read with --files-from-verbatim: paths only, no comments.
  write_file "$JOBS_DIR/$job/src" 0644 < <(printf '%s\n' "${_wl_src[@]}")
  write_file "$JOBS_DIR/$job/exclude" 0644 < <(
    printf "# Exclude patterns for resticagent job '%s' (restic --exclude-file syntax).\n" "$job"
    if (( ${#_wl_exclude[@]} > 0 )); then printf '%s\n' "${_wl_exclude[@]}"; fi
  )
}

install_hint() {
  if [[ -f "$SYSTEMD_DIR/$(timer_unit "$1").d/schedule.conf" ]]; then
    note "Apply the changes to its timer with: $SUDO$PROG install $1"
  else
    note "Activate it with: $SUDO$PROG install $1"
  fi
}

# ---------------------------------------------------------------------------
# restic and systemd helpers
# ---------------------------------------------------------------------------
require_restic() {
  command -v restic >/dev/null 2>&1 \
    || die "restic is not installed. Install it with your package manager (apt, dnf, pacman, zypper) or from https://github.com/restic/restic/releases"
  local version
  version=$(restic version 2>/dev/null) || die "'restic version' failed"
  if [[ "$version" =~ restic\ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    if (( BASH_REMATCH[1] == 0 && BASH_REMATCH[2] < MIN_RESTIC_MINOR )); then
      die "restic ${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]} is too old, 0.$MIN_RESTIC_MINOR or newer is needed. Try 'sudo restic self-update' or a release from https://github.com/restic/restic/releases"
    fi
  else
    warn "could not read the restic version from: $version"
  fi
}

require_systemd() {
  [[ -n "$ROOT" ]] && return 0
  command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]] \
    || die "systemd is not running on this host, and resticagent schedules backups with systemd timers"
  # su and sudo -u give a shell without the user's own systemd manager.
  if [[ "$SCOPE" == user ]] && ! sctl show-environment >/dev/null 2>&1; then
    die "cannot reach the systemd user manager of $(id -un). Run $PROG in a login session of that user, not through su or sudo -u"
  fi
  return 0
}

# run_systemctl ARGS... -> systemctl for calls that change state. With
# RESTICAGENT_ROOT set, enable, disable and is-enabled work offline on the
# system units below it, and every other call is only printed. systemctl
# --root does not support user units.
run_systemctl() {
  if [[ -z "$ROOT" ]]; then
    sctl "$@"
    return
  fi
  case $SCOPE/${1:-} in
    system/enable|system/disable|system/is-enabled)
      local arg
      local -a args=()
      for arg in "$@"; do
        [[ "$arg" == --now ]] || args+=("$arg")
      done
      systemctl --root="$ROOT" "${args[@]}"
      ;;
    *)
      note "  skipped (RESTICAGENT_ROOT is set): systemctl --$SCOPE $*"
      ;;
  esac
}

unit_is_active() { sctl is-active --quiet "$1" 2>/dev/null; }

timer_unit()   { printf '%s%s.timer' "$UNIT_PREFIX" "$1"; }
service_unit() { printf '%s%s.service' "$UNIT_PREFIX" "$1"; }
dropin_dir()   { printf '%s/%s.d' "$SYSTEMD_DIR" "$(timer_unit "$1")"; }
wants_link()   { printf '%s/timers.target.wants/%s' "$SYSTEMD_DIR" "$(timer_unit "$1")"; }

# job_installed JOB -> true when the job has a timer drop-in or an enabled timer
job_installed() {
  [[ -d "$(dropin_dir "$1")" || -L "$(wants_link "$1")" ]]
}

timer_enabled() {
  local state
  state=$(run_systemctl is-enabled "$(timer_unit "$1")" 2>/dev/null || true)
  [[ "$state" == enabled ]]
}

# A oneshot service is "activating" for as long as the backup runs.
service_running() {
  [[ "$(sctl show -P ActiveState "$(service_unit "$1")" 2>/dev/null || true)" == activating ]]
}

# installed_jobs -> jobs with a timer drop-in or an enabled timer (may repeat)
installed_jobs() {
  local path name
  for path in "$SYSTEMD_DIR/$UNIT_PREFIX"*.timer.d "$SYSTEMD_DIR/timers.target.wants/$UNIT_PREFIX"*.timer; do
    [[ -e "$path" || -L "$path" ]] || continue
    name=${path##*/"$UNIT_PREFIX"}
    name=${name%.timer.d}
    name=${name%.timer}
    if [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then printf '%s\n' "$name"; fi
  done
}

# known_jobs -> every configured or installed job, sorted, once each
known_jobs() { { list_jobs; installed_jobs; } | sort -u; }

# unit_props ARRAY UNIT PROP,PROP... -> ARRAY[PROP]=value from systemctl show
unit_props() {
  local -n _up_arr=$1
  local _up_line
  _up_arr=()
  while IFS= read -r _up_line; do
    [[ "$_up_line" == *=* ]] || continue
    # _up_arr is an associative array, so the key must be expanded.
    # shellcheck disable=SC2004
    _up_arr[${_up_line%%=*}]=${_up_line#*=}
  done < <(sctl show --property="$3" "$2" 2>/dev/null || true)
}

# journal_last_run UNIT -> sets LAST_RUN_TIME and LAST_RUN_RESULT (done, failed,
# ...) from the journal, which keeps the history across reboots when it is
# persistent. Returns 1 when the journal has no finished run of UNIT.
LAST_RUN_TIME='' LAST_RUN_RESULT=''
journal_last_run() {
  local line usec=''
  LAST_RUN_TIME='' LAST_RUN_RESULT=''
  while IFS= read -r line; do
    case $line in
      __REALTIME_TIMESTAMP=*) usec=${line#*=} ;;
      JOB_RESULT=*)           LAST_RUN_RESULT=${line#*=} ;;
    esac
  done < <(journalctl "$JOURNAL_UNIT" "$1" "MESSAGE_ID=$MSG_UNIT_STARTED" "MESSAGE_ID=$MSG_UNIT_FAILED" \
             -n 1 -o export --output-fields=JOB_RESULT --no-pager 2>/dev/null || true)
  [[ -n "$LAST_RUN_RESULT" && "$usec" =~ ^[0-9]+$ ]] || return 1
  LAST_RUN_TIME=$(date -d "@$(( usec / 1000000 ))" '+%a %Y-%m-%d %H:%M:%S %Z')
}

systemd_version() {
  local out
  out=$(systemctl --version 2>/dev/null || true)
  if [[ "$out" =~ ^systemd\ ([0-9]+) ]]; then echo "${BASH_REMATCH[1]}"; else echo 0; fi
}

# next_run UNIT CALENDAR -> the timer's next trigger as systemd reports it, or
# the next match of CALENDAR when the timer is not loaded
next_run() {
  local unit=$1 calendar=$2 when=''
  when=$(sctl show -P NextElapseUSecRealtime "$unit" 2>/dev/null || true)
  if [[ -z "$when" ]]; then
    when=$(systemd-analyze calendar -- "$calendar" 2>/dev/null | sed -n 's/^ *Next elapse: //p' || true)
  fi
  printf '%s' "${when:-unknown}"
}

# ---------------------------------------------------------------------------
# init: global settings -> /etc/resticagent/config
# ---------------------------------------------------------------------------
cmd_init() {
  require_root init
  load_env "$GLOBAL_CONFIG"

  local repo pwfile cache compression key kv
  local -a extras=()
  for key in "${!CUR[@]}"; do
    case $key in
      RESTIC_REPOSITORY|RESTIC_PASSWORD_FILE|RESTIC_CACHE_DIR|RESTIC_COMPRESSION) ;;
      *) extras+=("$key=${CUR[$key]}") ;;
    esac
  done
  if (( ${#extras[@]} > 0 )); then
    mapfile -t extras < <(printf '%s\n' "${extras[@]}" | sort)
  fi

  header "Global settings  ($GLOBAL_CONFIG)"
  note "Every job inherits these. A job can override the repository and password file."
  ask repo        "Default restic repository (sftp:user@host:/path, s3:..., /mnt/backup)" "${CUR[RESTIC_REPOSITORY]:-}" validate_required
  ask pwfile      "Default password file" "${CUR[RESTIC_PASSWORD_FILE]:-$CONFIG_DIR/password}" validate_abs_path
  ask cache       "restic cache directory" "${CUR[RESTIC_CACHE_DIR]:-$DEFAULT_CACHE_DIR}" validate_abs_path
  ask compression "Compression (auto, off, max)" "${CUR[RESTIC_COMPRESSION]:-auto}" validate_compression

  header "Additional environment variables"
  ask_list extras "Backend credentials and other restic settings, as KEY=VALUE (optional)." \
    "Examples: AWS_ACCESS_KEY_ID=..., AWS_SECRET_ACCESS_KEY=..., B2_ACCOUNT_ID=..., RESTIC_PACK_SIZE=64" \
    validate_key_value

  header "Writing"
  local -A settings=(
    [RESTIC_REPOSITORY]=$repo [RESTIC_PASSWORD_FILE]=$pwfile
    [RESTIC_CACHE_DIR]=$cache [RESTIC_COMPRESSION]=$compression
  )
  # settings is passed by name to write_global_config.
  # shellcheck disable=SC2034
  for kv in "${extras[@]}"; do settings[${kv%%=*}]=${kv#*=}; done
  write_global_config settings
  ensure_password_file "$pwfile"
}

# ---------------------------------------------------------------------------
# add: one backup job -> /etc/resticagent/config.d/<job>/{env,src,exclude}
# ---------------------------------------------------------------------------
cmd_add() {
  require_root add "$@"
  if [[ ! -f "$GLOBAL_CONFIG" ]]; then
    warn "no global settings yet, running '$PROG init' first"
    cmd_init
  fi

  local job=${1:-}
  if [[ -n "$job" ]]; then
    validate_job_name "$job" || die "invalid job name '$job'"
  else
    ask job "Job name (letters, digits, '-' and '_')" "" validate_job_name
  fi
  local job_dir="$JOBS_DIR/$job"

  load_env "$job_dir/env"
  local -a src=() exclude=()
  load_lines src "$job_dir/src"
  load_lines exclude "$job_dir/exclude"
  [[ -d "$job_dir" ]] && note "job '$job' already exists, prompts are pre-filled with its current values"

  header "Repository  (job '$job')"
  note "Leave empty to use the defaults from $GLOBAL_CONFIG."
  local repo pwfile
  ask repo   "Repository override"    "${CUR[RESTIC_REPOSITORY]:-}"    validate_value
  ask pwfile "Password file override" "${CUR[RESTIC_PASSWORD_FILE]:-}" validate_abs_path_or_empty

  # Defaults only apply to a new job. In an existing job an empty value was a
  # deliberate choice, such as a retention rule that was left out.
  local d_delay=15min d_daily=7 d_weekly=4 d_monthly=6 d_yearly=1 d_tags=$job
  if [[ -f "$job_dir/env" ]]; then
    d_delay='' d_daily='' d_weekly='' d_monthly='' d_yearly='' d_tags=''
  fi

  header "Schedule"
  local on_calendar delay
  ask on_calendar "When to run (systemd OnCalendar: daily, hourly, 'Mon..Fri 18:00', '*-*-* 02:00:00')" "${CUR[ON_CALENDAR]:-daily}" validate_calendar
  ask delay       "Random delay before each run (0, 30min, 1h)" "${CUR[RANDOMIZED_DELAY]:-$d_delay}" validate_timespan

  header "Retention  (which snapshots to keep)"
  note "Leave a rule empty to skip it. At least one rule is required."
  local keep_last keep_hourly keep_daily keep_weekly keep_monthly keep_yearly keep_within
  while true; do
    ask keep_last    "Keep the N most recent snapshots"       "${CUR[KEEP_LAST]:-}"     validate_int_or_empty
    ask keep_hourly  "Keep N hourly snapshots"                "${CUR[KEEP_HOURLY]:-}"   validate_int_or_empty
    ask keep_daily   "Keep N daily snapshots"                 "${CUR[KEEP_DAILY]:-$d_daily}"     validate_int_or_empty
    ask keep_weekly  "Keep N weekly snapshots"                "${CUR[KEEP_WEEKLY]:-$d_weekly}"   validate_int_or_empty
    ask keep_monthly "Keep N monthly snapshots"               "${CUR[KEEP_MONTHLY]:-$d_monthly}" validate_int_or_empty
    ask keep_yearly  "Keep N yearly snapshots"                "${CUR[KEEP_YEARLY]:-$d_yearly}"   validate_int_or_empty
    ask keep_within  "Keep every snapshot newer than (30d, 1y6m)" "${CUR[KEEP_WITHIN]:-}" validate_restic_duration_or_empty
    [[ -n "$keep_last$keep_hourly$keep_daily$keep_weekly$keep_monthly$keep_yearly$keep_within" ]] && break
    warn "restic forget needs at least one keep rule"
  done
  local prune
  if ask_yesno "Prune unreferenced data after forgetting snapshots?" "$(yn_default "${CUR[PRUNE]:-1}")"; then prune=1; else prune=0; fi

  header "Backup options"
  local tags one_fs
  ask tags "Tags, comma separated" "${CUR[BACKUP_TAGS]:-$d_tags}" validate_value
  if ask_yesno "Stay on one file system (skip other mounts below the source paths)?" "$(yn_default "${CUR[ONE_FILE_SYSTEM]:-1}")"; then one_fs=1; else one_fs=0; fi

  header "Source paths  ($job_dir/src)"
  while true; do
    ask_list src "Directories and files to back up." \
      "Absolute paths, e.g. /home, /etc, /var/lib/docker/volumes." validate_src_path
    (( ${#src[@]} > 0 )) && break
    warn "a job needs at least one source path"
  done

  header "Exclude patterns  ($job_dir/exclude)"
  ask_list exclude "Patterns restic should skip (optional)." \
    "restic globs, e.g. **/node_modules, **/.cache, *.tmp, /home/*/.local/share/Trash" validate_value

  local keep_summary=''
  [[ -n "$keep_last" ]]    && keep_summary+="last $keep_last, "
  [[ -n "$keep_hourly" ]]  && keep_summary+="hourly $keep_hourly, "
  [[ -n "$keep_daily" ]]   && keep_summary+="daily $keep_daily, "
  [[ -n "$keep_weekly" ]]  && keep_summary+="weekly $keep_weekly, "
  [[ -n "$keep_monthly" ]] && keep_summary+="monthly $keep_monthly, "
  [[ -n "$keep_yearly" ]]  && keep_summary+="yearly $keep_yearly, "
  [[ -n "$keep_within" ]]  && keep_summary+="within $keep_within, "
  keep_summary=${keep_summary%, }

  header "Summary"
  row "Job"            "$job"
  row "Repository"     "${repo:-(global default)}"
  row "Password file"  "${pwfile:-(global default)}"
  row "Schedule"       "$on_calendar${delay:+ (+ up to $delay)}"
  row "Keep"           "$keep_summary"
  row "Prune"          "$(yn_default "$prune")"
  row "Tags"           "$tags"
  row "One file system" "$(yn_default "$one_fs")"
  row "Sources"        "${#src[@]} path(s)"
  row "Excludes"       "${#exclude[@]} pattern(s)"
  ask_yesno "Write this configuration?" y || die "nothing written"

  header "Writing"
  local key
  local -A values=(
    [RESTIC_REPOSITORY]=$repo [RESTIC_PASSWORD_FILE]=$pwfile
    [ON_CALENDAR]=$on_calendar [RANDOMIZED_DELAY]=$delay
    [KEEP_LAST]=$keep_last [KEEP_HOURLY]=$keep_hourly [KEEP_DAILY]=$keep_daily
    [KEEP_WEEKLY]=$keep_weekly [KEEP_MONTHLY]=$keep_monthly [KEEP_YEARLY]=$keep_yearly
    [KEEP_WITHIN]=$keep_within [BACKUP_TAGS]=$tags [ONE_FILE_SYSTEM]=$one_fs [PRUNE]=$prune
  )
  # Keep variables that add does not ask about, such as overrides from import.
  for key in "${!CUR[@]}"; do
    [[ -n "${values[$key]+set}" ]] || values[$key]=${CUR[$key]}
  done
  write_job_env "$job" values
  write_job_lists "$job" src exclude
  ensure_password_file "$pwfile"
  ok "job '$job' configured"
  install_hint "$job"
}

# ---------------------------------------------------------------------------
# import: a job, and on a new host the global settings, from one env file
# ---------------------------------------------------------------------------
declare -A MASTER=()

# parse_master_file FILE -> MASTER[KEY]=VALUE for each KEY=VALUE line. The file
# is parsed, never sourced. Blank lines and lines starting with # are skipped,
# an "export " prefix is allowed, and one pair of surrounding quotes is removed.
# Problems are reported by line number only, since values may be secrets.
parse_master_file() {
  local file=$1 line key value n=0 bad=0
  local re_skip='^[[:space:]]*(#|$)'
  local re_pair='^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$'
  local re_squote="^'(.*)'\$" re_dquote='^"(.*)"$'
  MASTER=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$(( n + 1 ))
    line=${line%$'\r'}
    if [[ "$line" =~ $re_skip ]]; then continue; fi
    if [[ ! "$line" =~ $re_pair ]]; then
      warn "$file line $n is not KEY=VALUE"
      bad=1
      continue
    fi
    key=${BASH_REMATCH[2]}
    value=${BASH_REMATCH[3]}
    value=${value%"${value##*[![:space:]]}"}
    if [[ "$value" =~ $re_squote || "$value" =~ $re_dquote ]]; then value=${BASH_REMATCH[1]}; fi
    if [[ -n "${MASTER[$key]+set}" ]]; then warn "$file line $n sets $key again, the later value wins"; fi
    MASTER[$key]=$value
  done <"$file"
  return "$bad"
}

# split_list ARRAY VALUE -> the comma-separated items of VALUE, trimmed,
# without empty ones
split_list() {
  local -n _sl=$1
  local _sl_item
  local -a _sl_parts=()
  _sl=()
  IFS=',' read -r -a _sl_parts <<<"$2"
  for _sl_item in "${_sl_parts[@]}"; do
    _sl_item=${_sl_item#"${_sl_item%%[![:space:]]*}"}
    _sl_item=${_sl_item%"${_sl_item##*[![:space:]]}"}
    if [[ -n "$_sl_item" ]]; then _sl+=("$_sl_item"); fi
  done
}

# normalize_bool VALUE -> prints 1 or 0; fails for anything that isn't a yes or no
normalize_bool() {
  case ${1,,} in
    1|yes|y|true|on)  echo 1 ;;
    0|no|n|false|off) echo 0 ;;
    *) return 1 ;;
  esac
}

# import_check KEY VALUE VALIDATOR HINT -> 0 if VALIDATOR accepts VALUE,
# otherwise prints "KEY: HINT" and returns 1
import_check() {
  if "$3" "$2" >/dev/null 2>&1; then return 0; fi
  warn "$1: $4"
  return 1
}

cmd_import() {
  local file='' job='' to_global=0 yes=0 arg key rule item value bad=0 global_exists=0 any_keep=0
  local password='' has_password=0 repo pwfile label keep_summary
  local -a src=() exclude=() changed_global=() overrides=() names=()
  local -A jw=() newg=()
  for arg in "$@"; do
    case $arg in
      --global) to_global=1 ;;
      -y|--yes) yes=1 ;;
      -*)       die "unknown option '$arg' (see '$PROG help')" ;;
      *)
        if [[ -z "$file" ]]; then file=$arg
        elif [[ -z "$job" ]]; then job=$arg
        else die "import takes one FILE and an optional JOB name"
        fi
        ;;
    esac
  done
  [[ -n "$file" ]] || die "usage: $PROG import FILE [JOB] [--global] [-y]"
  [[ -f "$file" && -r "$file" ]] || die "cannot read $file"
  require_root import "$@"
  # Malformed lines are reported, and checking goes on, so every problem in
  # the file shows up in one pass.
  parse_master_file "$file" || bad=1

  # The job name: the JOB argument, else JOB= in the file, else the file name.
  if [[ -z "$job" ]]; then job=${MASTER[JOB]:-}; fi
  if [[ -z "$job" ]]; then job=$(basename -- "$file"); job=${job%.env}; fi
  validate_job_name "$job" || die "invalid job name '$job'. Name the job explicitly: $PROG import '$file' <job>"

  split_list src "${MASTER[SRC]:-}"
  split_list exclude "${MASTER[EXCLUDE]:-}"
  if [[ -n "${MASTER[RESTIC_PASSWORD]+set}" ]]; then
    has_password=1
    password=${MASTER[RESTIC_PASSWORD]}
  fi
  unset 'MASTER[JOB]' 'MASTER[SRC]' 'MASTER[EXCLUDE]' 'MASTER[RESTIC_PASSWORD]'

  # Job settings, with the same defaults as "add".
  jw[ON_CALENDAR]=${MASTER[ON_CALENDAR]:-daily}
  jw[RANDOMIZED_DELAY]=${MASTER[RANDOMIZED_DELAY]:-15min}
  for rule in "${KEEP_RULES[@]}"; do
    key="KEEP_${rule^^}"
    if [[ -n "${MASTER[$key]:-}" ]]; then
      jw[$key]=${MASTER[$key]}
      any_keep=1
    fi
  done
  if (( ! any_keep )); then
    jw[KEEP_DAILY]=7
    jw[KEEP_WEEKLY]=4
    jw[KEEP_MONTHLY]=6
    jw[KEEP_YEARLY]=1
  fi
  jw[BACKUP_TAGS]=${MASTER[BACKUP_TAGS]:-$job}
  for key in ONE_FILE_SYSTEM PRUNE; do
    if value=$(normalize_bool "${MASTER[$key]:-1}"); then
      jw[$key]=$value
    else
      warn "$key: use 1 or 0 (yes, no, true and false work too)"
      bad=1
    fi
  done
  for key in "${JOB_KEYS[@]}"; do unset "MASTER[$key]"; done

  # Everything left is for restic: repository, password file, credentials.
  for key in "${!MASTER[@]}"; do
    if [[ "$key" == KEEP_* ]]; then
      warn "$key is not a retention rule. Use KEEP_LAST, KEEP_HOURLY, KEEP_DAILY, KEEP_WEEKLY, KEEP_MONTHLY, KEEP_YEARLY or KEEP_WITHIN"
      bad=1
    elif [[ -z "${MASTER[$key]}" ]]; then
      unset "MASTER[$key]"
    else
      import_check "$key" "${MASTER[$key]}" validate_value "single quotes and backslashes are not allowed" || bad=1
    fi
  done

  import_check ON_CALENDAR "${jw[ON_CALENDAR]}" validate_calendar \
    "systemd rejects '${jw[ON_CALENDAR]}'. Examples: daily, hourly, 'Mon..Fri 18:00'" || bad=1
  import_check RANDOMIZED_DELAY "${jw[RANDOMIZED_DELAY]}" validate_timespan \
    "systemd rejects '${jw[RANDOMIZED_DELAY]}'. Examples: 0, 30min, 1h" || bad=1
  for rule in "${KEEP_RULES[@]}"; do
    key="KEEP_${rule^^}"
    [[ -n "${jw[$key]:-}" ]] || continue
    if [[ "$rule" == within ]]; then
      import_check "$key" "${jw[$key]}" validate_restic_duration_or_empty "use a restic duration such as 30d or 1y6m" || bad=1
    else
      import_check "$key" "${jw[$key]}" validate_int_or_empty "use a whole number" || bad=1
    fi
  done
  import_check BACKUP_TAGS "${jw[BACKUP_TAGS]}" validate_value "single quotes and backslashes are not allowed" || bad=1
  [[ -z "${MASTER[RESTIC_PASSWORD_FILE]:-}" ]] \
    || import_check RESTIC_PASSWORD_FILE "${MASTER[RESTIC_PASSWORD_FILE]}" validate_abs_path "use an absolute path" || bad=1
  [[ -z "${MASTER[RESTIC_CACHE_DIR]:-}" ]] \
    || import_check RESTIC_CACHE_DIR "${MASTER[RESTIC_CACHE_DIR]}" validate_abs_path "use an absolute path" || bad=1
  [[ -z "${MASTER[RESTIC_COMPRESSION]:-}" ]] \
    || import_check RESTIC_COMPRESSION "${MASTER[RESTIC_COMPRESSION]}" validate_compression "use auto, off or max" || bad=1

  if (( ${#src[@]} == 0 )); then
    warn "SRC: list at least one path to back up, separated by commas"
    bad=1
  fi
  for item in "${src[@]}"; do
    import_check SRC "$item" validate_abs_path "'$item' must be an absolute path without quotes or backslashes" || bad=1
    [[ "$item" != /* || -e "$item" ]] || warn "SRC: $item does not exist on this host (kept anyway)"
  done
  for item in "${exclude[@]}"; do
    import_check EXCLUDE "$item" validate_value "'$item' has a single quote or backslash" || bad=1
  done

  # On a new host the restic settings become the global settings. Once those
  # exist, a differing value only overrides them for this job, so importing
  # one job never changes the others. --global updates the global settings.
  CUR=()
  if [[ -f "$GLOBAL_CONFIG" ]]; then
    global_exists=1
    load_env "$GLOBAL_CONFIG"
  fi
  for key in "${!CUR[@]}"; do newg[$key]=${CUR[$key]}; done
  for key in "${!MASTER[@]}"; do
    if [[ "${CUR[$key]-}" == "${MASTER[$key]}" ]]; then
      continue
    elif (( ! global_exists || to_global )); then
      newg[$key]=${MASTER[$key]}
      changed_global+=("$key")
    else
      jw[$key]=${MASTER[$key]}
      overrides+=("$key")
    fi
  done
  if (( ! global_exists )); then
    if [[ -z "${newg[RESTIC_REPOSITORY]:-}" ]]; then
      warn "RESTIC_REPOSITORY: this host has no global settings yet, so the file must name the repository"
      bad=1
    fi
    newg[RESTIC_PASSWORD_FILE]=${newg[RESTIC_PASSWORD_FILE]:-$CONFIG_DIR/password}
    newg[RESTIC_CACHE_DIR]=${newg[RESTIC_CACHE_DIR]:-$DEFAULT_CACHE_DIR}
    newg[RESTIC_COMPRESSION]=${newg[RESTIC_COMPRESSION]:-auto}
  fi
  repo=${jw[RESTIC_REPOSITORY]:-${newg[RESTIC_REPOSITORY]:-}}
  pwfile=${jw[RESTIC_PASSWORD_FILE]:-${newg[RESTIC_PASSWORD_FILE]:-}}

  if (( has_password )); then
    if [[ -z "$password" ]]; then
      warn "RESTIC_PASSWORD is empty"
      bad=1
    elif [[ -e "$pwfile" && "$(<"$pwfile")" != "$password" ]]; then
      warn "RESTIC_PASSWORD differs from the password in $pwfile, and that file is never overwritten."
      warn "Change a repository's password with 'restic key passwd', then update the file."
      bad=1
    fi
  fi
  (( bad == 0 )) || die "nothing imported. Fix the problems above in $file"

  # Summary
  JENV=()
  for key in "${!jw[@]}"; do JENV[$key]=${jw[$key]}; done
  keep_summary=$(retention_summary long)
  header "Import  ($file)"
  if [[ -d "$JOBS_DIR/$job" ]]; then label="$job (exists, its settings will be replaced)"; else label="$job (new)"; fi
  row "Job" "$label"
  if [[ -n "${jw[RESTIC_REPOSITORY]:-}" ]]; then label="$repo (job)"; else label="$repo (global)"; fi
  row "Repository" "$label"
  label=$pwfile
  if (( has_password )) && [[ ! -e "$pwfile" ]]; then label+=" (will be created from RESTIC_PASSWORD)"; fi
  row "Password file" "$label"
  label=${jw[ON_CALENDAR]}
  if [[ "${jw[RANDOMIZED_DELAY]}" != 0 ]]; then label+=" (+ up to ${jw[RANDOMIZED_DELAY]})"; fi
  row "Schedule" "$label"
  row "Keep" "$keep_summary"
  row "Prune" "$(yes_no "${jw[PRUNE]:-0}")"
  row "Tags" "job:$job,${jw[BACKUP_TAGS]}"
  row "One file system" "$(yes_no "${jw[ONE_FILE_SYSTEM]:-0}")"
  row "Sources" "$(join_by ', ' "${src[@]}")"
  if (( ${#exclude[@]} > 0 )); then row "Excludes" "$(join_by ', ' "${exclude[@]}")"; else row "Excludes" "none"; fi
  if (( ! global_exists )); then
    row "Global settings" "will be created in $GLOBAL_CONFIG"
  elif (( ${#changed_global[@]} > 0 )); then
    sorted_keys names "${changed_global[@]}"
    row "Global settings" "${names[*]} will change for every job"
  fi
  if (( ${#overrides[@]} > 0 )); then
    sorted_keys names "${overrides[@]}"
    row "Job overrides" "${names[*]}, since they differ from the global settings"
    note "  To change the global settings instead, add --global."
  fi
  if (( ! yes )); then
    ask_yesno "Write this configuration?" y || die "nothing written"
  fi

  header "Writing"
  if (( ! global_exists || ${#changed_global[@]} > 0 )); then write_global_config newg; fi
  write_job_env "$job" jw
  write_job_lists "$job" src exclude
  if (( has_password )) && [[ ! -e "$pwfile" ]]; then
    mkdir -p "$(dirname "$pwfile")"
    (umask 077 && printf '%s\n' "$password" >"$pwfile")
    ok "created    $pwfile (mode 0600)"
  elif (( has_password )); then
    info "  unchanged  $pwfile"
  elif [[ ! -e "$pwfile" ]]; then
    if (( yes )) || [[ ! -t 0 ]]; then
      warn "password file $pwfile does not exist. Create it (mode 0600), or add RESTIC_PASSWORD to $file, before installing."
    else
      ensure_password_file "$pwfile"
    fi
  fi
  ok "job '$job' imported"
  install_hint "$job"
}

# ---------------------------------------------------------------------------
# install: program, unit templates, and one enabled timer per job
# ---------------------------------------------------------------------------

# check_job JOB -> loads JENV, prints every problem, returns 1 if not installable
check_job() {
  local job=$1 dir="$JOBS_DIR/$1" bad=0 path rule key has_rule=0
  local -a src=()
  if [[ ! -f "$dir/env" ]]; then
    warn "$job: $dir/env is missing. Run: $SUDO$PROG add $job"
    return 1
  fi
  load_job_env "$job"

  load_lines src "$dir/src"
  if (( ${#src[@]} == 0 )); then
    warn "$job: no source paths in $dir/src"; bad=1
  fi
  for path in "${src[@]}"; do
    [[ -e "$path" ]] || warn "$job: source $path does not exist on this host (restic will report it)"
  done

  [[ -n "${JENV[RESTIC_REPOSITORY]:-}" ]] || { warn "$job: no repository in the job or global settings"; bad=1; }

  path=${JENV[RESTIC_PASSWORD_FILE]:-}
  if [[ -z "$path" ]]; then
    warn "$job: no password file in the job or global settings"; bad=1
  elif [[ ! -r "$path" ]]; then
    warn "$job: password file $path is missing. Re-run: $SUDO$PROG add $job"; bad=1
  fi

  if [[ -z "${JENV[ON_CALENDAR]:-}" ]] || ! systemd-analyze calendar -- "${JENV[ON_CALENDAR]}" >/dev/null 2>&1; then
    warn "$job: ON_CALENDAR '${JENV[ON_CALENDAR]:-}' is not a valid systemd calendar expression"; bad=1
  fi
  if [[ -n "${JENV[RANDOMIZED_DELAY]:-}" ]] && ! systemd-analyze timespan -- "${JENV[RANDOMIZED_DELAY]}" >/dev/null 2>&1; then
    warn "$job: RANDOMIZED_DELAY '${JENV[RANDOMIZED_DELAY]}' is not a valid systemd time span"; bad=1
  fi

  for rule in "${KEEP_RULES[@]}"; do
    key="KEEP_${rule^^}"
    [[ -n "${JENV[$key]:-}" ]] && has_rule=1
  done
  (( has_rule )) || { warn "$job: no KEEP_* retention rule"; bad=1; }

  return "$bad"
}

# check_repo JOB -> opens the job's repository and offers to create a missing one.
# Returns 1 only when the job cannot work (no repository, wrong password).
# An unreachable repository is a warning, since the network may be down now.
declare -A REPO_CHECKED=()
check_repo() {
  local job=$1 repo=${JENV[RESTIC_REPOSITORY]} out rc=0
  local id="$repo|${JENV[RESTIC_PASSWORD_FILE]:-}"
  if [[ -n "${REPO_CHECKED[$id]:-}" ]]; then
    if (( REPO_CHECKED[$id] != 0 )); then
      warn "$job: uses the same repository and password as a job that failed above"
    fi
    return "${REPO_CHECKED[$id]}"
  fi
  out=$(export_job_env; timeout 120 restic --no-lock --no-cache cat config 2>&1 >/dev/null) || rc=$?
  case $rc in
    0)
      ok "repository $repo opens"
      ;;
    10)
      warn "$job: repository $repo does not exist yet"
      if [[ -t 0 ]] && ask_yesno "Initialize a new restic repository there?" y; then
        if (export_job_env; restic --no-cache init); then
          ok "initialized $repo"
          rc=0
        else
          warn "$job: restic init failed"
          rc=1
        fi
      else
        warn "$job: to create it, re-run '$SUDO$PROG install $job' in a terminal"
        rc=1
      fi
      ;;
    12)
      warn "$job: wrong password for $repo (password file ${JENV[RESTIC_PASSWORD_FILE]:-})"
      rc=1
      ;;
    124)
      warn "$job: no answer from $repo within 120s, activating anyway"
      rc=0
      ;;
    *)
      warn "$job: could not open $repo (restic exit $rc): $(tail -n 1 <<<"$out")"
      warn "$job: activating anyway. Test it with: $SUDO$PROG run $job"
      rc=0
      ;;
  esac
  REPO_CHECKED[$id]=$rc
  return "$rc"
}

# render_dropin JOB -> the timer drop-in that carries the job's schedule.
# The empty OnCalendar= clears the template's placeholder, because
# OnCalendar values from drop-ins are added to the list, not substituted.
render_dropin() {
  local job=$1
  local calendar=${JENV[ON_CALENDAR]:-} delay=${JENV[RANDOMIZED_DELAY]:-0}
  cat <<DROPIN
# Generated by "resticagent install" from ${JOBS_DIR#"$ROOT"}/$job/env.
# Change the job with "resticagent add $job", then run "resticagent install $job".
[Timer]
OnCalendar=
OnCalendar=${calendar//%/%%}
RandomizedDelaySec=${delay//%/%%}
DROPIN
}

install_program() {
  local src unit
  if [[ "$SELF" == "$(readlink -f "$BIN_PATH" 2>/dev/null || true)" ]]; then
    info "  running    $BIN_PATH (the installed copy)"
    return 0
  fi
  write_file "$BIN_PATH" 0755 <"$SELF"
  # The unit templates go along, so the installed copy can install units too.
  src=$(template_dir) || return 0
  for unit in "${UNIT_PREFIX}.service" "${UNIT_PREFIX}.timer"; do
    write_file "$SHARE_DIR/systemd/$unit" 0644 <"$src/$unit"
  done
}

# template_dir -> the directory with the unit templates that came with this
# program: ../systemd in a checkout, ../share/resticagent/systemd when installed
template_dir() {
  local dir
  for dir in "${SELF%/*}/../systemd" "${SELF%/*}/../share/resticagent/systemd"; do
    if [[ -f "$dir/${UNIT_PREFIX}.service" && -f "$dir/${UNIT_PREFIX}.timer" ]]; then
      readlink -f "$dir"
      return 0
    fi
  done
  return 1
}

# render_template FILE -> a unit template with the paths of this scope. User
# units leave out PrivateTmp=, which needs user namespaces there, and some
# hosts disable or restrict those.
render_template() {
  local bin=${BIN_PATH#"$ROOT"} config=${CONFIG_DIR#"$ROOT"} line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$SCOPE" == user && "$line" == PrivateTmp=* ]]; then continue; fi
    # Quoted replacements, so an & in a path is not read as the match.
    line=${line//\/usr\/local\/bin\/resticagent/"$bin"}
    line=${line//\/etc\/resticagent/"$config"}
    printf '%s\n' "$line"
  done <"$1"
}

install_templates() {
  local src_dir unit
  if src_dir=$(template_dir); then
    for unit in "${UNIT_PREFIX}.service" "${UNIT_PREFIX}.timer"; do
      write_file "$SYSTEMD_DIR/$unit" 0644 < <(render_template "$src_dir/$unit")
    done
  elif [[ -f "$SYSTEMD_DIR/${UNIT_PREFIX}.service" && -f "$SYSTEMD_DIR/${UNIT_PREFIX}.timer" ]]; then
    note "  unit templates are not next to $SELF, keeping the installed ones"
  else
    die "unit templates not found. Install resticagent with ./setup.sh, or run install from the repository checkout: ${SUDO}./bin/resticagent install"
  fi
}

cmd_install() {
  local skip_repo_check=0 all_jobs=0 arg job unit was_active
  local -a jobs=() ready=() failed=()
  local -A changed=() schedule=()
  for arg in "$@"; do
    case $arg in
      --skip-repo-check) skip_repo_check=1 ;;
      -*) die "unknown option '$arg' (see '$PROG help')" ;;
      *)  validate_job_name "$arg" || die "invalid job name '$arg'"; jobs+=("$arg") ;;
    esac
  done
  require_root install "$@"
  require_systemd
  require_restic
  [[ -f "$GLOBAL_CONFIG" ]] || die "no global settings at $GLOBAL_CONFIG. Run: $SUDO$PROG init"
  if (( ${#jobs[@]} == 0 )); then
    all_jobs=1
    mapfile -t jobs < <(list_jobs)
    (( ${#jobs[@]} > 0 )) || die "no jobs in $JOBS_DIR. Run: $SUDO$PROG add <job>"
  fi
  for job in "${jobs[@]}"; do
    [[ -d "$JOBS_DIR/$job" ]] || die "no job '$job' in $JOBS_DIR. Run: $SUDO$PROG add $job"
  done

  header "Program and unit templates"
  install_program
  install_templates

  header "Jobs"
  for job in "${jobs[@]}"; do
    if ! check_job "$job"; then failed+=("$job"); continue; fi
    if (( ! skip_repo_check )) && ! check_repo "$job"; then failed+=("$job"); continue; fi
    write_file "$SYSTEMD_DIR/$(timer_unit "$job").d/schedule.conf" 0644 < <(render_dropin "$job")
    if (( WRITE_CHANGED )); then changed[$job]=1; fi
    schedule[$job]="${JENV[ON_CALENDAR]}"
    ready+=("$job")
  done

  if (( all_jobs )); then
    while IFS= read -r job; do
      [[ -d "$JOBS_DIR/$job" ]] && continue
      warn "the timer for job '$job' is installed but its config is gone, so its runs are skipped"
      warn "clean it up with: $SUDO$PROG remove $job"
    done < <(installed_jobs | sort -u)
  fi

  header "Activating"
  if (( ANY_CHANGED )); then
    run_systemctl daemon-reload
    ok "reloaded   systemd units"
  fi
  for job in "${ready[@]}"; do
    unit=$(timer_unit "$job")
    was_active=0
    unit_is_active "$unit" && was_active=1
    # enable is idempotent: it creates the boot symlink only if missing.
    run_systemctl enable --now --quiet "$unit"
    if (( was_active )) && [[ -n "${changed[$job]:-}" ]]; then
      # A running timer keeps its old next-run time until restarted.
      run_systemctl restart "$unit"
      ok "restarted  $unit (schedule changed)"
    elif (( was_active )); then
      info "  active     $unit"
    else
      ok "started    $unit"
    fi
  done

  header "Summary"
  if (( ${#ready[@]} > 0 )); then
    printf '  %-16s %-24s %s\n' JOB SCHEDULE "NEXT RUN"
    for job in "${ready[@]}"; do
      printf '  %-16s %-24s %s\n' "$job" "${schedule[$job]}" "$(next_run "$(timer_unit "$job")" "${schedule[$job]}")"
    done
    # A user's manager, and with it their timers, runs only while they are
    # logged in, unless lingering is enabled for them.
    if [[ "$SCOPE" == user && -z "$ROOT" && "$(loginctl show-user "$(id -un)" -P Linger 2>/dev/null || true)" != yes ]]; then
      printf '\n'
      note "  Your timers run while you are logged in. A run missed meanwhile starts at your next login."
      note "  To run them whenever this machine is on, even before you log in: loginctl enable-linger"
    fi
  fi
  if (( ${#failed[@]} > 0 )); then
    warn "not activated: ${failed[*]} (see the messages above)"
    return 1
  fi
  ok "${#ready[@]} job(s) active"
}

# ---------------------------------------------------------------------------
# start: run a job now through systemd, exactly as its timer would
# ---------------------------------------------------------------------------

# A start job stays queued in systemd until the oneshot service has exited.
job_pending() {
  [[ -n "$(sctl list-jobs --no-legend "$1" 2>/dev/null || true)" ]]
}

# journal_tail_cursor UNIT -> the cursor of UNIT's newest journal entry, or empty
journal_tail_cursor() {
  journalctl "$JOURNAL_UNIT" "$1" -n 1 -q -o cat --no-pager --show-cursor 2>/dev/null | sed -n 's/^-- cursor: //p' || true
}

# journal_print_new UNIT FROM... -> prints UNIT's journal entries newer than
# FOLLOW_CURSOR, or on the first call those selected by FROM (--after-cursor C
# or --since T), and advances FOLLOW_CURSOR. Polling with a cursor never loses
# or repeats a line, unlike killing a "journalctl -f" that may still be behind.
FOLLOW_CURSOR=''
journal_print_new() {
  local line
  local -a args=("$JOURNAL_UNIT" "$1" -q -o cat --no-pager --show-cursor)
  if [[ -n "$FOLLOW_CURSOR" ]]; then args+=(--after-cursor "$FOLLOW_CURSOR"); else args+=("${@:2}"); fi
  while IFS= read -r line; do
    if [[ "$line" == "-- cursor: "* ]]; then
      FOLLOW_CURSOR=${line#-- cursor: }
    else
      printf '%s\n' "$line"
    fi
  done < <(journalctl "${args[@]}" 2>/dev/null || true)
}

# journal_run_result UNIT FROM... -> the JOB_RESULT (done, failed, ...) systemd
# logged when the run of UNIT after FROM ended; empty until then
journal_run_result() {
  journalctl "$JOURNAL_UNIT" "$1" "MESSAGE_ID=$MSG_UNIT_STARTED" "MESSAGE_ID=$MSG_UNIT_FAILED" "${@:2}" \
    -n 1 -o export --output-fields=JOB_RESULT --no-pager 2>/dev/null | sed -n 's/^JOB_RESULT=//p' || true
}

cmd_start() {
  local job='' wait=1 arg unit since started errfile result status job_result='' tries rc=0 interrupted=0
  local -a start_from=()
  for arg in "$@"; do
    case $arg in
      --no-wait) wait=0 ;;
      -*)        die "unknown option '$arg' (see '$PROG help')" ;;
      *)         [[ -z "$job" ]] || die "start takes a single job"; job=$arg ;;
    esac
  done
  [[ -n "$job" ]] || die "usage: $PROG start JOB [--no-wait]"
  validate_job_name "$job" || die "invalid job name '$job'"
  require_root start "$@"
  require_systemd
  [[ -f "$JOBS_DIR/$job/env" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  [[ -f "$SYSTEMD_DIR/${UNIT_PREFIX}.service" ]] \
    || die "the systemd units are not installed yet. Run: $SUDO$PROG install $job"
  if ! job_installed "$job"; then
    note "job '$job' has no timer yet, so it only runs when started by hand. Schedule it with: $SUDO$PROG install $job"
  fi
  unit=$(service_unit "$job")

  if [[ -n "$ROOT" ]]; then
    run_systemctl start --no-block "$unit"
    return 0
  fi

  if service_running "$job" || job_pending "$unit"; then
    # Never start a second copy; follow the run in progress instead.
    started=$(sctl show -P ExecMainStartTimestamp "$unit" 2>/dev/null || true)
    since=$(sctl show --timestamp=unix -P ExecMainStartTimestamp "$unit" 2>/dev/null || true)
    # systemd before 247 has no --timestamp=unix; then follow from now.
    [[ "$since" == @* ]] || since="@$(date +%s)"
    start_from=(--since "$since")
    info "A backup of '$job' is already running, since ${started:-a moment ago}."
    if (( ! wait )); then
      note "Follow it with: $SUDO$PROG logs $job -f"
      return 0
    fi
  else
    # Follow from the unit's newest journal entry, so not even a line of a
    # run that ended in the same second shows up. Timestamps are too coarse.
    since=$(journal_tail_cursor "$unit")
    if [[ -n "$since" ]]; then start_from=(--after-cursor "$since"); else start_from=(--since "@$(date +%s)"); fi
    errfile=$(mktemp)
    if ! run_systemctl start --no-block "$unit" 2>"$errfile"; then
      printf '%serror:%s could not start %s\n' "$C_RED" "$C_RESET" "$unit" >&2
      sed 's/^/  /' "$errfile" >&2
      rm -f "$errfile"
      return 1
    fi
    rm -f "$errfile"
    if (( ! wait )); then
      ok "started    $unit"
      note "Follow it with: $SUDO$PROG logs $job -f    Check the result with: $SUDO$PROG status"
      return 0
    fi
  fi
  info "==> $unit  (Ctrl-C stops following; the backup keeps running)"

  FOLLOW_CURSOR=''
  trap 'interrupted=1' INT
  while (( ! interrupted )) && { job_pending "$unit" || service_running "$job"; }; do
    journal_print_new "$unit" "${start_from[@]}"
    sleep 0.5 || true
  done
  # systemd logs the end of the run as the job completes, but journald may
  # store it a moment later. Print up to and including that message.
  for (( tries = 0; tries < 15 && ! interrupted; tries++ )); do
    job_result=$(journal_run_result "$unit" "${start_from[@]}")
    journal_print_new "$unit" "${start_from[@]}"
    [[ -z "$job_result" ]] || break
    sleep 0.2 || true
  done
  trap - INT

  if (( interrupted )) && { job_pending "$unit" || service_running "$job"; }; then
    printf '\n'
    warn "stopped following. The backup of '$job' continues in the background."
    note "Follow it again with: $SUDO$PROG logs $job -f    Check the result with: $SUDO$PROG status"
    return 130
  fi

  result=$(sctl show -P Result "$unit" 2>/dev/null || true)
  status=$(sctl show -P ExecMainStatus "$unit" 2>/dev/null || true)
  printf '\n'
  if [[ "$job_result" == "done" || ( -z "$job_result" && "$result" == success ) ]]; then
    ok "backup of '$job' finished successfully"
    return 0
  fi
  if [[ "$result" == exit-code && "$status" =~ ^[0-9]+$ && "$status" != 0 ]]; then
    if [[ "$status" == 3 ]]; then
      warn "backup of '$job' finished, but some files could not be read (exit 3)"
    else
      printf "%serror:%s backup of '%s' failed (exit %s)\n" "$C_RED" "$C_RESET" "$job" "$status" >&2
    fi
    note "See the whole run with: $SUDO$PROG logs $job --last"
    rc=$status
  else
    printf "%serror:%s backup of '%s' did not complete (%s)\n" "$C_RED" "$C_RESET" "$job" "${job_result:-${result:-unknown result}}" >&2
    note "See the whole run with: $SUDO$PROG logs $job --last"
    rc=1
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# run: one backup plus retention; this is what the systemd service executes
# ---------------------------------------------------------------------------
cmd_run() {
  local job=${1:-} rule key rc=0
  [[ -n "$job" ]] || die "usage: $PROG run JOB"
  validate_job_name "$job" || die "invalid job name '$job'"
  require_root run "$@"
  local dir="$JOBS_DIR/$job"
  [[ -f "$dir/env" && -f "$dir/src" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  require_restic
  load_job_env "$job"
  export_job_env

  # Every snapshot carries job:<name>, so forget only ever touches this job's
  # snapshots, even when several jobs share one repository.
  local -a backup=(backup --retry-lock 30m --files-from-verbatim "$dir/src" --tag "job:$job")
  [[ -f "$dir/exclude" ]] && backup+=(--exclude-file "$dir/exclude")
  [[ "${JENV[ONE_FILE_SYSTEM]:-0}" == 1 ]] && backup+=(--one-file-system)
  [[ -n "${JENV[BACKUP_TAGS]:-}" ]] && backup+=(--tag "${JENV[BACKUP_TAGS]}")

  # Grouping by host alone keeps retention stable when the source list changes.
  local -a forget=(forget --retry-lock 30m --tag "job:$job" --group-by host)
  local -a keep=()
  for rule in "${KEEP_RULES[@]}"; do
    key="KEEP_${rule^^}"
    if [[ -n "${JENV[$key]:-}" ]]; then keep+=("--keep-$rule" "${JENV[$key]}"); fi
  done
  [[ "${JENV[PRUNE]:-0}" == 1 ]] && forget+=(--prune)

  info "==> backup of job '$job' to ${JENV[RESTIC_REPOSITORY]:-?}"
  restic "${backup[@]}" || rc=$?
  case $rc in
    0) ;;
    3) warn "some source files could not be read, the snapshot was saved without them" ;;
    *) printf 'error: backup failed (restic exit %d), retention not applied\n' "$rc" >&2; return "$rc" ;;
  esac

  if (( ${#keep[@]} == 0 )); then
    warn "no KEEP_* rules for job '$job', retention not applied"
    return "$rc"
  fi
  info "==> retention for job '$job': ${keep[*]}"
  local forget_rc=0
  restic "${forget[@]}" "${keep[@]}" || forget_rc=$?
  if (( forget_rc != 0 )); then
    printf 'error: forget failed (restic exit %d)\n' "$forget_rc" >&2
    return "$forget_rc"
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# snapshots: the snapshots one job has made
# ---------------------------------------------------------------------------
cmd_snapshots() {
  local job=${1:-} arg out rc=0 json=0
  [[ -n "$job" && "$job" != -* ]] || die "usage: $PROG snapshots JOB [restic snapshots options]  (see '$PROG help')"
  shift
  validate_job_name "$job" || die "invalid job name '$job'"
  for arg in "$@"; do
    case $arg in
      # restic ORs repeated --tag filters, which would let in other jobs.
      --tag|--tag=*) die "snapshots only shows the snapshots tagged job:$job, so --tag cannot be used" ;;
      --json)        json=1 ;;
    esac
  done
  require_root snapshots "$job" "$@"
  [[ -f "$JOBS_DIR/$job/env" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  require_restic
  load_job_env "$job"
  export_job_env

  if (( ! json )); then header "Snapshots of job '$job' in ${JENV[RESTIC_REPOSITORY]:-?}"; fi
  # Reading takes no lock, so a running backup or prune does not block it.
  out=$(restic snapshots --no-lock --tag "job:$job" "$@") || rc=$?
  if (( rc != 0 )); then
    printf "%serror:%s could not list the snapshots of job '%s' (restic exit %d)\n" "$C_RED" "$C_RESET" "$job" "$rc" >&2
    return "$rc"
  fi
  # restic prints nothing at all when no snapshot matches.
  if [[ -n "$out" ]]; then
    printf '%s\n' "$out"
  elif (( $# > 0 )); then
    info "No snapshots of job '$job' match."
  else
    info "Job '$job' has no snapshots yet. Make one now with: $SUDO$PROG start $job"
  fi
}

# ---------------------------------------------------------------------------
# show: the files in one snapshot of a job, through ls -alh or tree
# ---------------------------------------------------------------------------

# json_unescape TEXT -> TEXT, a JSON string without its quotes, with the
# escapes undone. printf %b reads \\, \n, \t and \uXXXX like JSON does.
json_unescape() {
  local s=$1
  s=${s//\\\"/\"}
  s=${s//\\\//\/}
  printf '%b' "$s"
}

# json_strings KEY -> the string value of the first KEY in the JSON on stdin,
# or each string of it when the value is a list, one per line
json_strings() {
  local raw item
  raw=$(grep -oE "\"$1\":(\"([^\"\\\\]|\\\\.)*\"|\[(\"([^\"\\\\]|\\\\.)*\",?)*\])" | head -n 1) || true
  raw=${raw#"\"$1\":"}
  while IFS= read -r item; do
    item=${item#\"}
    json_unescape "${item%\"}"
    printf '\n'
  done < <(grep -oE '"([^"\\]|\\.)*"' <<<"$raw" || true)
}

# common_dir PATH... -> the deepest directory that holds every PATH, or the
# PATH itself when there is only one
common_dir() {
  local base=$1 p
  shift
  for p in "$@"; do
    while [[ "$p" != "$base" && "$p" != "$base"/* && "$base" != / ]]; do base=$(dirname "$base"); done
  done
  printf '%s' "$base"
}

# tree_input BASE -> turns the output of restic ls --long on stdin into input
# for tree --fromfile --fflinks: paths relative to BASE, directories ending in
# "/" and symlinks as "name -> target". The first line is the directory they
# are relative to: BASE, or its parent when BASE is not a directory.
# Exits 3 when the input holds no entries.
tree_input() {
  SHOW_BASE=$1 awk '
    function parent(p) { sub(/\/[^\/]*$/, "", p); return p == "" ? "/" : p }
    BEGIN { base = ENVIRON["SHOW_BASE"] }
    # mode uid gid size date time path[ -> target]; the header line does not match.
    match($0, /^[^ ]+ +[0-9]+ +[0-9]+ +[0-9]+ [0-9-]+ [0-9:]+ /) {
      m = substr($0, 1, 1)
      p = substr($0, RLENGTH + 1)
      t = ""
      if (m == "L" && (k = index(p, " -> ")) > 0) { t = substr(p, k); p = substr(p, 1, k - 1) }
      if (!n++) {
        if (p == base && m != "d") base = parent(base)
        print base
      }
      if (p != base) print substr(p, base == "/" ? 2 : length(base) + 2) (m == "d" ? "/" : "") t
    }
    END { if (!n) exit 3 }
  '
}

# check_snapshot_arg JOB SNAPSHOT -> dies unless SNAPSHOT is an ID or "latest"
check_snapshot_arg() {
  [[ "$2" == latest || "$2" =~ ^[0-9a-f]{1,64}$ ]] \
    || die "'$2' is not a snapshot. Use an ID from '$SUDO$PROG snapshots $1', or latest"
}

# resolve_snapshot JOB SNAPSHOT [PATH] -> finds SNAPSHOT (an ID or latest) of
# JOB and prints its header. Sets SNAP_ID, and SNAP_ROOTS to PATH or else to
# the paths the snapshot backed up. restic ignores --tag for an explicit ID,
# so the job tag is checked here, and another job's snapshot is refused.
# Returns restic's exit code, or 1, after saying what went wrong.
SNAP_ID='' SNAP_ROOTS=()
resolve_snapshot() {
  local job=$1 snap=$2 path=${3:-} json errfile time host tag found=0 rc=0
  local -a tags=()
  errfile=$(mktemp)
  if [[ "$snap" == latest ]]; then
    json=$(restic snapshots --no-lock --json --tag "job:$job" latest 2>"$errfile") || rc=$?
  else
    json=$(restic snapshots --no-lock --json "$snap" 2>"$errfile") || rc=$?
  fi
  SNAP_ID=$(json_strings id <<<"$json")
  if (( rc != 0 )) || [[ -z "$SNAP_ID" ]]; then
    if (( rc != 0 )); then
      printf "%serror:%s could not read the snapshots of job '%s' (restic exit %d)\n" "$C_RED" "$C_RESET" "$job" "$rc" >&2
    elif [[ "$snap" == latest ]]; then
      printf "%serror:%s job '%s' has no snapshots yet. Make one with: %s\n" "$C_RED" "$C_RESET" "$job" "$SUDO$PROG start $job" >&2
      rc=1
    else
      printf "%serror:%s no snapshot matches '%s'. See the snapshots of job '%s' with: %s\n" "$C_RED" "$C_RESET" "$snap" "$job" "$SUDO$PROG snapshots $job" >&2
      rc=1
    fi
    sed 's/^/  /' "$errfile" >&2
    rm -f "$errfile"
    return "$rc"
  fi
  rm -f "$errfile"
  mapfile -t tags < <(json_strings tags <<<"$json")
  for tag in "${tags[@]}"; do
    if [[ "$tag" == "job:$job" ]]; then found=1; fi
  done
  (( found )) || die "snapshot ${SNAP_ID:0:8} was not made by job '$job'. See its snapshots with: $SUDO$PROG snapshots $job"

  if [[ -n "$path" ]]; then
    while [[ "$path" == */ && "$path" != / ]]; do path=${path%/}; done
    SNAP_ROOTS=("$path")
  else
    mapfile -t SNAP_ROOTS < <(json_strings paths <<<"$json")
  fi
  time=$(json_strings time <<<"$json")
  host=$(json_strings hostname <<<"$json")
  header "Snapshot ${SNAP_ID:0:8} of job '$job', made ${time:0:10} ${time:11:5} on $host"
}

# The temporary FUSE mount that show runs ls in, and the restic process behind it
SHOW_MNT='' SHOW_PID='' SHOW_LOG=''

# show_mount JOB -> mounts the snapshots of JOB with restic mount on a new
# directory SHOW_MNT, and waits until they can be read
show_mount() {
  SHOW_MNT=$(mktemp -d)
  SHOW_LOG=$(mktemp)
  trap show_unmount EXIT
  trap 'exit 130' INT TERM
  restic mount --no-lock --tag "job:$1" "$SHOW_MNT" >"$SHOW_LOG" 2>&1 &
  SHOW_PID=$!
  until [[ -d "$SHOW_MNT/ids" ]]; do
    if ! kill -0 "$SHOW_PID" 2>/dev/null; then
      printf "%serror:%s could not mount the snapshots of job '%s' with restic mount\n" "$C_RED" "$C_RESET" "$1" >&2
      sed 's/^/  /' "$SHOW_LOG" >&2
      exit 1
    fi
    sleep 0.2
  done
}

# show_unmount -> stops restic mount, which unmounts, and removes the mount
# point. Safe to call more than once.
show_unmount() {
  if [[ -n "$SHOW_PID" ]]; then
    kill -INT "$SHOW_PID" 2>/dev/null || true
    wait "$SHOW_PID" 2>/dev/null || true
    SHOW_PID=''
  fi
  if [[ -n "$SHOW_MNT" ]]; then
    if mountpoint -q "$SHOW_MNT" 2>/dev/null; then
      fusermount3 -u "$SHOW_MNT" 2>/dev/null || fusermount -u "$SHOW_MNT" 2>/dev/null || umount "$SHOW_MNT" 2>/dev/null || true
    fi
    rmdir "$SHOW_MNT" 2>/dev/null || warn "could not remove the mount point $SHOW_MNT"
    SHOW_MNT=''
  fi
  if [[ -n "$SHOW_LOG" ]]; then rm -f "$SHOW_LOG"; SHOW_LOG=''; fi
}

cmd_show() {
  local job='' snap='' path='' mode=list arg id out input base entries dir r shown=0 rc=0
  local -a roots=() missing=() tree_args=()
  for arg in "$@"; do
    case $arg in
      --tree) mode=tree ;;
      -*)     die "unknown option '$arg' (see '$PROG help')" ;;
      /*)     [[ -z "$path" ]] || die "show takes a single path"; path=$arg ;;
      *)
        if [[ -z "$job" ]]; then job=$arg
        elif [[ -z "$snap" ]]; then snap=$arg
        else die "usage: $PROG show JOB [SNAPSHOT] [PATH] [--tree]  (see '$PROG help')"
        fi ;;
    esac
  done
  [[ -n "$job" ]] || die "usage: $PROG show JOB [SNAPSHOT] [PATH] [--tree]  (see '$PROG help')"
  validate_job_name "$job" || die "invalid job name '$job'"
  snap=${snap:-latest}
  check_snapshot_arg "$job" "$snap"
  require_root show "$@"
  [[ -f "$JOBS_DIR/$job/env" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  if [[ "$mode" == tree ]]; then
    command -v tree >/dev/null 2>&1 \
      || die "--tree needs the tree command. Install it with your package manager (apt, dnf, pacman, zypper)"
  elif [[ ! -e /dev/fuse ]] || { (( EUID != 0 )) && ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; }; then
    die "show runs ls on a FUSE mount of the snapshot, and FUSE is not available here. Install fuse3 with your package manager, or use --tree, which does not need it"
  fi
  require_restic
  load_job_env "$job"
  export_job_env
  resolve_snapshot "$job" "$snap" "$path" || return
  id=$SNAP_ID
  roots=("${SNAP_ROOTS[@]}")

  if [[ "$mode" == tree ]]; then
    # tree reads the paths from restic ls instead of from a file system.
    out=$(restic ls --no-lock --long --recursive "$id" "${roots[@]}") || rc=$?
    if (( rc != 0 )); then
      printf "%serror:%s could not list snapshot %s (restic exit %d)\n" "$C_RED" "$C_RESET" "${id:0:8}" "$rc" >&2
      return "$rc"
    fi
    input=$(tree_input "$(common_dir "${roots[@]}")" <<<"$out") || rc=$?
    if (( rc == 3 )); then die "snapshot ${id:0:8} does not contain $(join_by ', ' "${roots[@]}")"; fi
    base=${input%%$'\n'*}
    entries=''
    if [[ "$input" == *$'\n'* ]]; then entries=${input#*$'\n'}; fi
    tree_args=(--fromfile --fflinks)
    # tree colors its output only on a terminal, which sed below hides from it.
    if [[ -t 1 && -n "${LS_COLORS:-}${TREE_COLORS:-}" ]]; then tree_args+=(-C); fi
    # tree calls the directory it reads "." in its first line; print the real path instead.
    printf '%s\n' "$base"
    if [[ -n "$entries" ]]; then printf '%s\n' "$entries"; fi | tree "${tree_args[@]}" . | sed 1d || rc=$?
    return "$rc"
  fi

  # ls needs a file system, so the snapshot is mounted for as long as it runs.
  show_mount "$job"
  dir="$SHOW_MNT/ids/${id:0:8}"
  [[ -d "$dir" ]] || die "snapshot ${id:0:8} is missing from the mounted repository"
  for r in "${roots[@]}"; do
    if [[ ! -e "$dir$r" && ! -L "$dir$r" ]]; then missing+=("$r"); continue; fi
    if (( shown )); then printf '\n'; fi
    shown=1
    printf '%s:\n' "$r"
    # ls runs inside the snapshot, so it prints names rather than mount paths.
    if [[ -d "$dir$r" && ! -L "$dir$r" ]]; then
      (cd "$dir$r" && ls -alh --color=auto) || rc=$?
    else
      (cd "$dir$(dirname "$r")" && ls -alh --color=auto -- "$(basename "$r")") || rc=$?
    fi
  done
  show_unmount
  if (( ${#missing[@]} > 0 )); then
    (( shown )) || die "snapshot ${id:0:8} does not contain $(join_by ', ' "${missing[@]}")"
    warn "snapshot ${id:0:8} does not contain $(join_by ', ' "${missing[@]}")"
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# restore: put files from a snapshot back, in place or below another directory
# ---------------------------------------------------------------------------

# glob_escape TEXT -> TEXT with the characters that restic patterns treat
# specially escaped, so --include matches the name literally
glob_escape() {
  local s=${1//\\/\\\\}
  s=${s//\*/\\*}
  s=${s//\?/\\?}
  s=${s//\[/\\[}
  printf '%s' "$s"
}

# dest_of TARGET PATH -> where PATH of a snapshot goes when restored to TARGET
dest_of() {
  if [[ "$1" == / ]]; then printf '%s' "$2"
  elif [[ "$2" == / ]]; then printf '%s' "$1"
  else printf '%s%s' "$1" "$2"
  fi
}

# root_types ID PATH... -> "d<TAB>PATH" for each PATH that is a folder in
# snapshot ID, and "f<TAB>PATH" for each that is a file or symlink
root_types() {
  local id=$1 out
  shift
  out=$(restic ls --no-lock --long "$id" "$@") || return
  RESTORE_ROOTS=$(printf '%s\n' "$@") awk '
    BEGIN { n = split(ENVIRON["RESTORE_ROOTS"], r, "\n"); for (i = 1; i <= n; i++) isroot[r[i]] = 1 }
    # mode uid gid size date time path[ -> target]; the header line does not match.
    match($0, /^[^ ]+ +[0-9]+ +[0-9]+ +[0-9]+ [0-9-]+ [0-9:]+ /) {
      m = substr($0, 1, 1)
      p = substr($0, RLENGTH + 1)
      if (m == "L" && (k = index(p, " -> ")) > 0) p = substr(p, 1, k - 1)
      if (p in isroot) print (m == "d" ? "d" : "f") "\t" p
    }' <<<"$out"
}

# restore_plan DEST -> sums up the output of restic restore --dry-run --json -vv
# into DEST, on stdin: a first line with the numbers of new, overwritten,
# deleted and untouched files, then a line per new (n), overwritten (u) or
# deleted (d) path, still JSON-escaped. Folders that restic merely sets up
# again are not counted.
restore_plan() {
  RESTORE_DEST=$1 awk '
    BEGIN { dest = ENVIRON["RESTORE_DEST"] }
    /"message_type":"verbose_status"/ {
      if (!match($0, /"action":"[a-z]+"/)) next
      act = substr($0, RSTART + 10, RLENGTH - 11)
      if (!match($0, /"item":"([^"\\]|\\.)*"/)) next
      p = substr($0, RSTART + 8, RLENGTH - 9)
      # Deleted paths come with the target; the others are relative to it.
      if (act != "deleted" && dest != "/") p = dest p
      n++; A[n] = act; P[n] = p
      for (q = p; sub(/\/[^\/]*$/, "", q) && q != "";) isdir[q] = 1
    }
    END {
      for (i = 1; i <= n; i++) {
        if (A[i] == "restored" && !(P[i] in isdir)) { new++; out = out "n\t" P[i] "\n" }
        else if (A[i] == "updated") { upd++; out = out "u\t" P[i] "\n" }
        else if (A[i] == "deleted") { del++; out = out "d\t" P[i] "\n" }
        else if (A[i] == "unchanged") same++
      }
      printf "%d %d %d %d\n%s", new, upd, del, same, out
    }'
}

# plan_items KIND TITLE LIMIT -> lists the KIND paths of a restore plan on
# stdin under TITLE, at most LIMIT of them, or all with LIMIT 0
plan_items() {
  local kind=$1 title=$2 limit=$3 n=0 line
  local -a items=()
  mapfile -t items < <(grep "^$kind"$'\t' || true)
  (( ${#items[@]} > 0 )) || return 0
  info "    $title:"
  for line in "${items[@]}"; do
    if (( limit > 0 && n >= limit )); then
      note "      and $(( ${#items[@]} - n )) more. See them all with --dry-run"
      break
    fi
    info "      $(json_unescape "${line#*$'\t'}")"
    n=$(( n + 1 ))
  done
}

# restore_args I -> sets args to the restic restore arguments of the I-th path
# of cmd_restore (bash's dynamic scope gives access to its arrays)
restore_args() {
  args=("${srcs[$1]}" --target "${dests[$1]}" "${opts[@]}")
  if (( dels[$1] )); then args+=(--delete); fi
  if [[ -n "${incs[$1]}" ]]; then args+=(--include "${incs[$1]}"); fi
}

cmd_restore() {
  local job='' snap='' path='' target=/ overwrite='' delete=0 dry_run=0 yes=0 arg id r kind line i out plan rc=0
  local new upd del same changes=0
  local -a orig=("$@") types=() missing=() srcs=() dests=() incs=() dels=() labels=() todo=() opts=() args=()
  while (( $# > 0 )); do
    arg=$1
    shift
    # --target=DIR works as well as --target DIR.
    if [[ "$arg" == --*=* ]]; then set -- "${arg#*=}" "$@"; arg=${arg%%=*}; fi
    case $arg in
      --target)
        [[ -n "${1:-}" ]] || die "--target needs a directory"
        target=$1
        shift ;;
      --overwrite)
        [[ "${1:-}" =~ ^(always|if-changed|if-newer|never)$ ]] || die "--overwrite needs always, if-changed, if-newer or never"
        overwrite=$1
        shift ;;
      --delete)  delete=1 ;;
      --dry-run) dry_run=1 ;;
      -y|--yes)  yes=1 ;;
      -*)        die "unknown option '$arg' (see '$PROG help')" ;;
      /*)        [[ -z "$path" ]] || die "restore takes a single path"; path=$arg ;;
      *)
        if [[ -z "$job" ]]; then job=$arg
        elif [[ -z "$snap" ]]; then snap=$arg
        else die "usage: $PROG restore JOB [SNAPSHOT] [PATH] [--target DIR] [options]  (see '$PROG help')"
        fi ;;
    esac
  done
  [[ -n "$job" ]] || die "usage: $PROG restore JOB [SNAPSHOT] [PATH] [--target DIR] [options]  (see '$PROG help')"
  validate_job_name "$job" || die "invalid job name '$job'"
  snap=${snap:-latest}
  check_snapshot_arg "$job" "$snap"
  [[ "$target" == /* ]] || target="$PWD/$target"
  while [[ "$target" == */ && "$target" != / ]]; do target=${target%/}; done
  require_root restore "${orig[@]}"
  [[ -f "$JOBS_DIR/$job/env" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  require_restic
  load_job_env "$job"
  export_job_env
  resolve_snapshot "$job" "$snap" "$path" || return
  id=$SNAP_ID

  # A folder is restored with itself as the target, so --delete cannot reach
  # beyond it. A file is restored through its folder with --include, and
  # --delete, which would act on that whole folder, is left out for it.
  out=$(root_types "$id" "${SNAP_ROOTS[@]}") || rc=$?
  if (( rc != 0 )); then
    printf "%serror:%s could not read snapshot %s (restic exit %d)\n" "$C_RED" "$C_RESET" "${id:0:8}" "$rc" >&2
    return "$rc"
  fi
  if [[ -n "$out" ]]; then mapfile -t types <<<"$out"; fi
  for r in "${SNAP_ROOTS[@]}"; do
    kind=''
    for line in "${types[@]}"; do
      if [[ "${line#*$'\t'}" == "$r" ]]; then kind=${line%%$'\t'*}; fi
    done
    if [[ -z "$kind" ]]; then missing+=("$r"); continue; fi
    if [[ "$kind" == d ]]; then
      srcs+=("$id:$r")
      dests+=("$(dest_of "$target" "$r")")
      incs+=('')
      dels+=("$delete")
      labels+=("$r")
    else
      if (( delete )) && [[ -n "$path" ]]; then die "--delete only works on folders, and $r is a file"; fi
      srcs+=("$id:$(dirname "$r")")
      dests+=("$(dest_of "$target" "$(dirname "$r")")")
      incs+=("/$(glob_escape "$(basename "$r")")")
      dels+=(0)
      labels+=("$r (file)")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    (( ${#srcs[@]} > 0 )) || die "snapshot ${id:0:8} does not contain $(join_by ', ' "${missing[@]}")"
    warn "snapshot ${id:0:8} does not contain $(join_by ', ' "${missing[@]}")"
  fi

  if [[ -n "$overwrite" ]]; then opts+=(--overwrite "$overwrite"); fi
  case ${overwrite:-always} in
    always)     info "Files that differ from the snapshot are overwritten." ;;
    if-changed) info "Files that differ from the snapshot are overwritten. Files whose size and time match are taken as unchanged." ;;
    if-newer)   info "Files that differ from the snapshot are overwritten, unless they are newer than the snapshot." ;;
    never)      info "Files that exist are kept. Only missing files are restored." ;;
  esac
  if (( delete )); then info "Files in the restored folders that are not in the snapshot are deleted."; fi

  # Preview every path with restic's dry run before anything is written.
  for i in "${!srcs[@]}"; do
    restore_args "$i"
    out=$(restic restore --no-lock --json -vv --dry-run "${args[@]}") || rc=$?
    if (( rc != 0 )); then
      printf "%serror:%s could not plan the restore of %s (restic exit %d)\n" "$C_RED" "$C_RESET" "${labels[$i]}" "$rc" >&2
      return "$rc"
    fi
    plan=$(restore_plan "${dests[$i]}" <<<"$out")
    read -r new upd del same <<<"${plan%%$'\n'*}"
    printf '\n'
    if [[ "${dests[$i]}" == "${srcs[$i]#*:}" ]]; then
      info "${labels[$i]}, in place:"
    else
      info "${labels[$i]}, to ${dests[$i]}:"
    fi
    if (( new + upd + del == 0 )); then
      case ${overwrite:-always} in
        always|if-changed) info "  nothing to restore: its $same file(s) match the snapshot" ;;
        *)                 info "  nothing to restore: its $same file(s) exist and are kept" ;;
      esac
      continue
    fi
    todo+=("$i")
    changes=$(( changes + new + upd + del ))
    row "$new new" "files restored"
    row "$upd overwritten" "files replaced by the snapshot's version"
    if (( dels[i] )); then row "$del deleted" "files and folders not in the snapshot"; fi
    row "$same untouched" "files that match the snapshot or are kept"
    if (( dry_run )); then
      plan_items n "New" 0 <<<"$plan"
      plan_items u "Overwritten" 0 <<<"$plan"
      plan_items d "Deleted" 0 <<<"$plan"
    else
      plan_items u "Overwritten" 20 <<<"$plan"
      plan_items d "Deleted" 20 <<<"$plan"
    fi
  done
  printf '\n'
  if (( changes == 0 )); then
    ok "nothing to restore"
    return 0
  fi
  if (( dry_run )); then
    note "Dry run: nothing was restored."
    return 0
  fi
  if (( ! yes )); then
    ask_yesno "Proceed?" n || die "nothing restored"
  fi

  header "Restoring"
  for i in "${todo[@]}"; do
    restore_args "$i"
    info "==> ${labels[$i]}"
    restic restore --retry-lock 30m "${args[@]}" || rc=$?
    if (( rc != 0 )); then
      printf "%serror:%s restoring %s failed (restic exit %d)\n" "$C_RED" "$C_RESET" "${labels[$i]}" "$rc" >&2
      return "$rc"
    fi
  done
  ok "restored ${#todo[@]} path(s) from snapshot ${id:0:8} of job '$job'"
}

# ---------------------------------------------------------------------------
# forget: delete chosen snapshots of one job, after listing them
# ---------------------------------------------------------------------------

# json_ids -> the full snapshot IDs in the restic JSON on stdin, in order.
# Quotes inside JSON strings are escaped, so "id":" only matches the key.
json_ids() { { grep -o '"id":"[0-9a-f]\{64\}"' || true; } | cut -d'"' -f4; }

# forget_plan_ids keep|remove -> the IDs that restic forget --json on stdin
# keeps or removes. Each group's lists are split onto lines of their own.
forget_plan_ids() {
  sed -E 's/"(keep|remove|reasons)":/\n&/g' | { grep "^\"$1\":" || true; } | json_ids
}

cmd_forget() {
  local job='' arg keep_last='' older_than='' oldest='' dry_run=0 yes=0 prune='' prune_hint='' repo json id rc=0
  local -a orig=("$@") rules=() listed=() ids=() kept=() forget=()
  local -A is_kept=()
  while (( $# > 0 )); do
    arg=$1
    shift
    # --keep-last=5 works as well as --keep-last 5.
    if [[ "$arg" == --*=* ]]; then set -- "${arg#*=}" "$@"; arg=${arg%%=*}; fi
    case $arg in
      --keep-last|--oldest)
        [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || die "$arg needs a whole number of 1 or more"
        if [[ "$arg" == --keep-last ]]; then keep_last=$1; else oldest=$1; fi
        shift ;;
      --older-than)
        [[ "${1:-}" =~ ^([0-9]+[ymdh])+$ ]] || die "--older-than needs a restic duration such as 30d, 2m or 1y6m"
        older_than=$1
        shift ;;
      --dry-run)  dry_run=1 ;;
      --prune)    prune=1 ;;
      --no-prune) prune=0 ;;
      -y|--yes)   yes=1 ;;
      -*)         die "unknown option '$arg' (see '$PROG help')" ;;
      *)          [[ -z "$job" ]] || die "forget takes a single job"; job=$arg ;;
    esac
  done
  [[ -n "$job" ]] || die "usage: $PROG forget JOB --keep-last N | --older-than DURATION | --oldest N  (see '$PROG help')"
  validate_job_name "$job" || die "invalid job name '$job'"
  [[ -n "$keep_last$older_than$oldest" ]] || die "choose what to forget with --keep-last N, --older-than DURATION or --oldest N"
  if [[ -n "$oldest" && -n "$keep_last$older_than" ]]; then die "--oldest cannot be combined with --keep-last or --older-than"; fi
  require_root forget "${orig[@]}"
  [[ -f "$JOBS_DIR/$job/env" ]] || die "job '$job' is not configured. Run: $SUDO$PROG add $job"
  require_restic
  load_job_env "$job"
  export_job_env
  repo=${JENV[RESTIC_REPOSITORY]:-?}
  if [[ -z "$prune" ]]; then
    if [[ "${JENV[PRUNE]:-0}" == 1 ]]; then prune=1; else prune=0; fi
    prune_hint=' Add --prune to prune now.'
  fi

  # Pick the exact snapshots up front, and later forget them by ID, so what is
  # forgotten is what was listed even if a backup finishes in between. Reading
  # takes no lock, so a running backup does not hold up the list.
  if [[ -n "$oldest" ]]; then
    json=$(restic snapshots --no-lock --json --tag "job:$job") \
      || die "could not read the snapshots of job '$job' in $repo"
    # Without --group-by, restic lists the snapshots oldest first.
    mapfile -t listed < <(json_ids <<<"$json")
    ids=("${listed[@]:0:oldest}")
    kept=("${listed[@]:oldest}")
  else
    # The same selection and grouping as the job's retention in run.
    [[ -n "$keep_last" ]] && rules+=(--keep-last "$keep_last")
    [[ -n "$older_than" ]] && rules+=(--keep-within "$older_than")
    json=$(restic forget --no-lock --dry-run --json --tag "job:$job" --group-by host "${rules[@]}") \
      || die "could not work out which snapshots of job '$job' to forget in $repo"
    mapfile -t ids < <(forget_plan_ids remove <<<"$json")
    mapfile -t kept < <(forget_plan_ids keep <<<"$json")
    for id in "${kept[@]}"; do is_kept[$id]=1; done
    for id in "${ids[@]}"; do
      [[ -z "${is_kept[$id]:-}" ]] || die "could not read the plan of restic forget, so nothing was forgotten"
    done
  fi

  if (( ${#ids[@]} + ${#kept[@]} == 0 )); then
    info "Job '$job' has no snapshots in $repo."
    return 0
  fi
  if (( ${#ids[@]} == 0 )); then
    ok "nothing to forget: all ${#kept[@]} snapshots of job '$job' are kept"
    return 0
  fi

  header "Snapshots of job '$job' to forget"
  restic snapshots --no-lock --compact "${ids[@]}" || die "could not list the snapshots to forget"
  header "This will"
  info "  - forget ${#ids[@]} of the $(( ${#ids[@]} + ${#kept[@]} )) snapshots of job '$job' in $repo"
  if (( prune )); then
    info "  - prune the repository, to free the data no other snapshot uses"
  else
    info "  - leave their data in the repository until it is pruned.$prune_hint"
  fi
  note "Snapshots of other jobs are not touched."
  if (( ${#kept[@]} == 0 )); then warn "this forgets every snapshot of job '$job'"; fi
  if (( dry_run )); then
    note "Dry run: nothing was forgotten."
    return 0
  fi
  if (( ! yes )); then
    ask_yesno "Proceed?" n || die "nothing forgotten"
  fi

  header "Forgetting"
  forget=(forget --retry-lock 30m)
  if (( prune )); then forget+=(--prune); fi
  restic "${forget[@]}" "${ids[@]}" || rc=$?
  if (( rc != 0 )); then
    printf '%serror:%s forget failed (restic exit %d)\n' "$C_RED" "$C_RESET" "$rc" >&2
    return "$rc"
  fi
  ok "forgot ${#ids[@]} snapshot(s) of job '$job'"
}

# ---------------------------------------------------------------------------
# Shared output helpers for list and status
# ---------------------------------------------------------------------------

# tsv CELL... -> the cells joined by tabs, one table row
tsv() { local IFS=$'\t'; printf '%s' "$*"; }

# table ROW... -> aligned columns; the first ROW is the header. Cells must not
# be empty (use "-"), because read collapses consecutive tabs.
table() {
  local -a widths=() cells=()
  local row i last line bold=$C_BOLD
  for row in "$@"; do
    IFS=$'\t' read -r -a cells <<<"$row"
    for i in "${!cells[@]}"; do
      if (( ${#cells[i]} > ${widths[i]:-0} )); then widths[i]=${#cells[i]}; fi
    done
  done
  for row in "$@"; do
    IFS=$'\t' read -r -a cells <<<"$row"
    last=$(( ${#cells[@]} - 1 ))
    line=''
    for i in "${!cells[@]}"; do
      if (( i < last )); then
        printf -v line '%s%-*s  ' "$line" "${widths[i]}" "${cells[i]}"
      else
        line+=${cells[i]}
      fi
    done
    printf '  %s%s%s\n' "$bold" "$line" "$C_RESET"
    bold=''
  done
}

describe_file() {
  if [[ -z "$1" ]]; then printf -- '-'
  elif [[ -r "$1" ]]; then printf '%s (present)' "$1"
  else printf '%s (missing)' "$1"
  fi
}

yes_no() { if [[ "$1" == 1 ]]; then printf yes; else printf no; fi; }

# origin KEY -> whether KEY comes from the job's env (in CUR) or the global config
origin() { if [[ -n "${CUR[$1]:-}" ]]; then printf '(job)'; else printf '(global)'; fi; }

# retention_summary short|long -> the keep rules in JENV, e.g. "last 3 7d 4w"
retention_summary() {
  local style=$1 rule key value out=''
  for rule in "${KEEP_RULES[@]}"; do
    key="KEEP_${rule^^}"
    value=${JENV[$key]:-}
    [[ -n "$value" ]] || continue
    if [[ "$style" == long ]]; then
      out+="$rule $value, "
    else
      case $rule in
        last|within) out+="$rule $value " ;;
        *)           out+="$value${rule:0:1} " ;;
      esac
    fi
  done
  out=${out%, }
  out=${out% }
  printf '%s' "${out:--}"
}

# install_state JOB -> installed | disabled | needs install | not installed | orphaned
# "needs install" means the schedule in the job's env differs from its timer.
install_state() {
  local job=$1 dropin
  dropin="$(dropin_dir "$job")/schedule.conf"
  if [[ ! -d "$JOBS_DIR/$job" ]]; then echo orphaned; return 0; fi
  if [[ ! -f "$dropin" ]]; then echo "not installed"; return 0; fi
  load_job_env "$job"
  if ! cmp -s "$dropin" <(render_dropin "$job"); then echo "needs install"; return 0; fi
  if timer_enabled "$job"; then echo installed; else echo disabled; fi
}

# ---------------------------------------------------------------------------
# list: what is configured, and whether it is installed
# ---------------------------------------------------------------------------
cmd_list() {
  local job=${1:-} state key hint_install=0 hint_orphan=0
  local -a jobs=() rows=() src=() others=()
  if [[ -n "$job" ]]; then
    validate_job_name "$job" || die "invalid job name '$job'"
  fi
  require_root list "$@"
  if [[ -n "$job" ]]; then
    list_job "$job"
    return
  fi

  header "Global settings  ($GLOBAL_CONFIG)"
  if [[ -f "$GLOBAL_CONFIG" ]]; then
    load_env "$GLOBAL_CONFIG"
    row "Repository"    "${CUR[RESTIC_REPOSITORY]:--}"
    row "Password file" "$(describe_file "${CUR[RESTIC_PASSWORD_FILE]:-}")"
    row "Cache"         "${CUR[RESTIC_CACHE_DIR]:--}"
    row "Compression"   "${CUR[RESTIC_COMPRESSION]:--}"
    for key in "${!CUR[@]}"; do
      case $key in
        RESTIC_REPOSITORY|RESTIC_PASSWORD_FILE|RESTIC_CACHE_DIR|RESTIC_COMPRESSION) ;;
        *) others+=("$key") ;;
      esac
    done
    if (( ${#others[@]} > 0 )); then
      mapfile -t others < <(printf '%s\n' "${others[@]}" | sort)
      row "Other variables" "${others[*]} (values hidden)"
    fi
  else
    warn "not configured yet. Run: $SUDO$PROG init"
  fi

  header "Jobs"
  mapfile -t jobs < <(known_jobs)
  if (( ${#jobs[@]} == 0 )); then
    info "  none yet. Add one with: $SUDO$PROG add <job>"
    system_jobs_hint
    return 0
  fi
  rows=("$(tsv JOB STATE SCHEDULE RETENTION SOURCES)")
  for job in "${jobs[@]}"; do
    state=$(install_state "$job")
    case $state in
      orphaned) hint_orphan=1 ;;
      installed) ;;
      *) hint_install=1 ;;
    esac
    if [[ "$state" == orphaned ]]; then
      rows+=("$(tsv "$job" "timer without config" - - -)")
      continue
    fi
    load_job_env "$job"
    load_lines src "$JOBS_DIR/$job/src"
    rows+=("$(tsv "$job" "$state" "${JENV[ON_CALENDAR]:--}" "$(retention_summary short)" "${#src[@]} path(s)")")
  done
  table "${rows[@]}"
  printf '\n'
  note "  Retention: h/d/w/m/y = hourly/daily/weekly/monthly/yearly snapshots kept."
  if (( hint_install )); then note "  Activate or update jobs with: $SUDO$PROG install"; fi
  if (( hint_orphan )); then note "  Clean up timers without config with: $SUDO$PROG remove <job>"; fi
  note "  Show one job in full with: $SUDO$PROG list <job>"
}

list_job() {
  local job=$1 dir="$JOBS_DIR/$1" state i delay next key
  local -a src=() exclude=() names=() extra=()
  if [[ ! -d "$dir" ]]; then
    job_installed "$job" || die "no job '$job'. See all jobs with: $SUDO$PROG list"
    warn "job '$job' has an installed timer but no config in $dir"
    note "Clean it up with: $SUDO$PROG remove $job"
    return 1
  fi
  state=$(install_state "$job")
  load_env "$dir/env"
  load_job_env "$job"
  load_lines src "$dir/src"
  load_lines exclude "$dir/exclude"
  delay=${JENV[RANDOMIZED_DELAY]:-0}

  header "Job '$job'  ($dir)"
  row "State"           "$state"
  row "Repository"      "${JENV[RESTIC_REPOSITORY]:--} $(origin RESTIC_REPOSITORY)"
  row "Password file"   "$(describe_file "${JENV[RESTIC_PASSWORD_FILE]:-}") $(origin RESTIC_PASSWORD_FILE)"
  row "Schedule"        "${JENV[ON_CALENDAR]:--}$([[ "$delay" == 0 ]] || printf ', random delay up to %s' "$delay")"
  # Only systemd knows when the installed timer fires next; the env file may
  # hold a newer schedule that has not been installed yet.
  next=$(sctl show -P NextElapseUSecRealtime "$(timer_unit "$job")" 2>/dev/null || true)
  row "Next run"        "${next:-not scheduled (timer not running)}"
  row "Retention"       "$(retention_summary long)"
  row "Prune"           "$(yes_no "${JENV[PRUNE]:-0}")"
  row "Tags"            "job:$job${JENV[BACKUP_TAGS]:+,${JENV[BACKUP_TAGS]}}"
  row "One file system" "$(yes_no "${JENV[ONE_FILE_SYSTEM]:-0}")"
  for key in "${!CUR[@]}"; do
    job_managed_key "$key" || names+=("$key")
  done
  if (( ${#names[@]} > 0 )); then
    sorted_keys extra "${names[@]}"
    row "Other variables" "${extra[*]} (this job only, values hidden)"
  fi

  header "Sources  ($dir/src)"
  for i in "${!src[@]}"; do printf '  %2d  %s\n' "$((i + 1))" "${src[$i]}"; done
  header "Excludes  ($dir/exclude)"
  if (( ${#exclude[@]} == 0 )); then info "  (none)"; fi
  for i in "${!exclude[@]}"; do printf '  %2d  %s\n' "$((i + 1))" "${exclude[$i]}"; done
  case $state in
    "needs install") printf '\n'; note "The schedule changed since the last install. Apply it with: $SUDO$PROG install $job" ;;
    "not installed"|disabled) printf '\n'; note "Activate it with: $SUDO$PROG install $job" ;;
  esac
}

# ---------------------------------------------------------------------------
# status: timers and the outcome of the last runs (no root needed)
# ---------------------------------------------------------------------------
S_TIMER='' S_LAST='' S_RESULT='' S_NEXT=''

# status_of JOB -> sets S_TIMER, S_LAST, S_RESULT and S_NEXT
status_of() {
  local job=$1
  local -A tp=() sp=()
  unit_props tp "$(timer_unit "$job")" ActiveState,NextElapseUSecRealtime
  unit_props sp "$(service_unit "$job")" ActiveState,Result,ExecMainStatus,ExecMainStartTimestamp

  if job_installed "$job"; then
    S_TIMER=${tp[ActiveState]:-unknown}
    timer_enabled "$job" || S_TIMER+=", disabled"
  else
    S_TIMER="not installed"
  fi
  [[ -d "$JOBS_DIR/$job" ]] || S_TIMER+=", no config"

  S_NEXT=${tp[NextElapseUSecRealtime]:-}
  [[ -n "$S_NEXT" ]] || S_NEXT=-

  # The service's own properties describe the last run since boot. Older runs
  # are looked up in the journal.
  if [[ "${sp[ActiveState]:-}" == activating ]]; then
    S_LAST=${sp[ExecMainStartTimestamp]:--}
    S_RESULT=running
  elif [[ -n "${sp[ExecMainStartTimestamp]:-}" ]]; then
    S_LAST=${sp[ExecMainStartTimestamp]}
    case ${sp[Result]:-}/${sp[ExecMainStatus]:-} in
      success/*)   S_RESULT=ok ;;
      exit-code/3) S_RESULT="partial (exit 3, unreadable files)" ;;
      exit-code/*) S_RESULT="failed (exit ${sp[ExecMainStatus]:-?})" ;;
      *)           S_RESULT="failed (${sp[Result]:-unknown})" ;;
    esac
  elif journal_last_run "$(service_unit "$job")"; then
    S_LAST=$LAST_RUN_TIME
    case $LAST_RUN_RESULT in
      done)   S_RESULT=ok ;;
      failed) S_RESULT=failed ;;
      *)      S_RESULT="failed ($LAST_RUN_RESULT)" ;;
    esac
  else
    S_LAST=-
    S_RESULT="never run"
  fi
}

cmd_status() {
  local job=${1:-} any_failed=0
  local -a jobs=() rows=()
  if [[ -n "$job" ]]; then
    validate_job_name "$job" || die "invalid job name '$job'"
    [[ -d "$JOBS_DIR/$job" ]] || job_installed "$job" || die "no job '$job' is configured or installed"
    sctl status --no-pager --full --lines=20 "$(timer_unit "$job")" "$(service_unit "$job")" || true
    status_of "$job"
    case $S_RESULT in failed*|partial*) return 1 ;; esac
    return 0
  fi

  mapfile -t jobs < <(known_jobs)
  if (( ${#jobs[@]} == 0 )); then
    info "No jobs are configured or installed. Add one with: $SUDO$PROG add <job>"
    system_jobs_hint
    return 0
  fi
  rows=("$(tsv JOB TIMER "LAST RUN" RESULT "NEXT RUN")")
  for job in "${jobs[@]}"; do
    status_of "$job"
    case $S_RESULT in failed*|partial*) any_failed=1 ;; esac
    rows+=("$(tsv "$job" "$S_TIMER" "$S_LAST" "$S_RESULT" "$S_NEXT")")
  done
  table "${rows[@]}"
  printf '\n'
  note "  Details: $SUDO$PROG status <job>    Logs: $SUDO$PROG logs <job>"
  return "$any_failed"
}

# ---------------------------------------------------------------------------
# logs: the journal of the backup services
# ---------------------------------------------------------------------------
cmd_logs() {
  local job='' last=0 arg since
  local -a args=() extra=()
  if [[ $# -gt 0 && "$1" != -* ]]; then
    job=$1
    shift
    validate_job_name "$job" || die "invalid job name '$job'"
  fi
  for arg in "$@"; do
    if [[ "$arg" == --last ]]; then last=1; else extra+=("$arg"); fi
  done

  if [[ -n "$job" ]]; then
    args=("$JOURNAL_UNIT" "$(service_unit "$job")")
  else
    args=("$JOURNAL_UNIT" "${UNIT_PREFIX}*.service")
  fi

  if (( last )); then
    [[ -n "$job" ]] || die "--last needs a job name, e.g. $SUDO$PROG logs home --last"
    if (( $(systemd_version) >= 257 )); then
      args+=(-I)   # the latest invocation of the unit
    else
      since=$(sctl show --timestamp=unix -P ExecMainStartTimestamp "$(service_unit "$job")" 2>/dev/null || true)
      [[ -n "$since" ]] || die "'$job' has not run since the last boot. See its full history with: $SUDO$PROG logs $job"
      args+=(--since "$since")
    fi
  elif (( ${#extra[@]} == 0 )); then
    args+=(-e -n 200)   # open the pager at the newest of the last 200 lines
  fi
  exec journalctl "${args[@]}" "${extra[@]}"
}

# ---------------------------------------------------------------------------
# remove: deactivate jobs and delete their files (never snapshots)
# ---------------------------------------------------------------------------
cmd_remove() {
  local all=0 purge=0 keep_config=0 yes=0 arg job unit file dir pwfile=''
  local -a jobs=()
  for arg in "$@"; do
    case $arg in
      --all)         all=1 ;;
      --purge)       purge=1 ;;
      --keep-config) keep_config=1 ;;
      -y|--yes)      yes=1 ;;
      -*)            die "unknown option '$arg' (see '$PROG help')" ;;
      *)             validate_job_name "$arg" || die "invalid job name '$arg'"; jobs+=("$arg") ;;
    esac
  done
  if (( all && ${#jobs[@]} > 0 )); then die "name jobs or use --all, not both"; fi
  if (( ! all && ${#jobs[@]} == 0 )); then die "usage: $PROG remove JOB... | --all  (see '$PROG help')"; fi
  if (( purge && ! all )); then die "--purge only works together with --all"; fi
  if (( purge && keep_config )); then die "--purge and --keep-config contradict each other"; fi
  require_root remove "$@"
  require_systemd

  if (( all )); then
    mapfile -t jobs < <(known_jobs)
  else
    for job in "${jobs[@]}"; do
      [[ -d "$JOBS_DIR/$job" ]] || job_installed "$job" || die "no job '$job' is configured or installed"
    done
  fi
  if [[ -f "$GLOBAL_CONFIG" ]]; then
    load_env "$GLOBAL_CONFIG"
    pwfile=${CUR[RESTIC_PASSWORD_FILE]:-}
  fi

  header "This will"
  if (( ${#jobs[@]} == 0 )); then info "  - remove no jobs, since none are configured or installed"; fi
  for job in "${jobs[@]}"; do
    info "  - stop and disable $(timer_unit "$job")"
    if [[ -d "$(dropin_dir "$job")" ]]; then info "  - delete $(dropin_dir "$job")"; fi
    if (( ! keep_config )) && [[ -d "$JOBS_DIR/$job" ]]; then info "  - delete $JOBS_DIR/$job"; fi
  done
  if (( all )); then
    info "  - delete the unit templates in $SYSTEMD_DIR and $SHARE_DIR, and $BIN_PATH"
    if (( purge )); then
      info "  - delete $CONFIG_DIR, including the global settings and any password file in it"
    elif (( keep_config )); then
      info "  - keep everything in $CONFIG_DIR"
    else
      info "  - keep $GLOBAL_CONFIG and the password file"
    fi
  elif (( keep_config )); then
    info "  - keep the job config in $JOBS_DIR"
  fi
  note "Snapshots in the repositories are not touched."
  if (( purge )); then
    warn "without the repository password, the existing snapshots cannot be restored. Keep a copy somewhere safe."
  fi
  if (( ! yes )); then
    ask_yesno "Proceed?" n || die "nothing removed"
  fi

  header "Removing"
  for job in "${jobs[@]}"; do
    unit=$(timer_unit "$job")
    if service_running "$job"; then
      warn "$job: a backup is running now. It will finish, but no new runs will start."
    fi
    # Disable needs the template, so jobs go before the templates do.
    if run_systemctl disable --now --quiet "$unit" 2>/dev/null; then
      ok "disabled   $unit"
    else
      warn "$job: systemctl could not disable $unit, removing its files directly"
    fi
    file=$(wants_link "$job")
    if [[ -L "$file" ]]; then rm -f -- "$file"; ok "deleted    $file"; ANY_CHANGED=1; fi
    dir=$(dropin_dir "$job")
    if [[ -d "$dir" ]]; then rm -rf -- "${dir:?}"; ok "deleted    $dir"; ANY_CHANGED=1; fi
    if (( ! keep_config )) && [[ -d "$JOBS_DIR/$job" ]]; then
      rm -rf -- "${JOBS_DIR:?}/${job:?}"
      ok "deleted    $JOBS_DIR/$job"
    fi
    run_systemctl reset-failed "$(service_unit "$job")" "$unit" >/dev/null 2>&1 || true
  done

  if (( all )); then
    for file in "$SYSTEMD_DIR/${UNIT_PREFIX}.service" "$SYSTEMD_DIR/${UNIT_PREFIX}.timer"; do
      if [[ -e "$file" ]]; then rm -f -- "$file"; ok "deleted    $file"; ANY_CHANGED=1; fi
    done
    for file in "$SHARE_DIR/systemd/${UNIT_PREFIX}.service" "$SHARE_DIR/systemd/${UNIT_PREFIX}.timer"; do
      if [[ -e "$file" ]]; then rm -f -- "$file"; ok "deleted    $file"; fi
    done
    rmdir "$SHARE_DIR/systemd" "$SHARE_DIR" 2>/dev/null || true
    if [[ -e "$BIN_PATH" ]]; then rm -f -- "$BIN_PATH"; ok "deleted    $BIN_PATH"; fi
    if (( purge )) && [[ -d "$CONFIG_DIR" ]]; then
      rm -rf -- "${CONFIG_DIR:?}"
      ok "deleted    $CONFIG_DIR"
      if [[ -n "$pwfile" && -e "$pwfile" ]]; then note "kept $pwfile, since it is outside $CONFIG_DIR"; fi
    fi
  fi

  if (( ANY_CHANGED )); then
    run_systemctl daemon-reload
    ok "reloaded   systemd units"
  fi
  ok "removed ${#jobs[@]} job(s)"
  if (( all )) && [[ -f "$SHARE_DIR/manifest" ]]; then
    note "What setup.sh installed besides the program stays. Remove it with: ./setup.sh --uninstall"
  fi
  if (( ${#jobs[@]} > 0 )); then
    note "To delete a job's snapshots as well, run restic forget --tag job:<job> --prune against its repository."
  fi
}

# ---------------------------------------------------------------------------
# Dispatcher
# ---------------------------------------------------------------------------
usage() {
  cat <<USAGE
Usage: $PROG [--system] <command> [arguments]

Run as a regular user, $PROG manages your own backups with
your systemd user units and needs no root. Run as root, it manages the
system-wide backups. --system selects those without root, for status and logs.

Configuration (stored under ${CONFIG_DIR#"$ROOT"}):
  init                Create or update the global settings
  add [JOB]           Create or update one backup job
  import FILE [JOB] [--global] [-y]
                      Create or replace one job from an env file instead of
                      prompts. SRC= and EXCLUDE= hold comma-separated lists.
                      On a new host it also creates the global settings.
  list [JOB]          Show the settings and install state of every job, or of
                      one job in full

Activation:
  install [--skip-repo-check] [JOB...]
                      Install this program and the systemd units, check each
                      job's repository, and enable one timer per job. Without
                      JOB names every configured job is installed.
  remove JOB... [--keep-config] [-y]
                      Stop and delete the jobs' timers and their config.
                      With --keep-config the config stays, for a later install.
  remove --all [--keep-config | --purge] [-y]
                      Remove every job, the unit templates and the installed
                      program. Global settings and the password file stay
                      unless --purge is given. Snapshots are never touched.

Monitoring:
  status [JOB]        Timer state, last run, result and next run of every job.
                      With JOB, the full systemctl status of its units.
                      Exits 1 when a job's last run failed.
  logs [JOB] [--last] [journalctl options]
                      The journal of every job, or of one job, opened at the
                      newest line. --last shows only the most recent run of JOB.
                      Other options go to journalctl, e.g. -f or --since today.

Running a job now:
  start JOB [--no-wait]
                      Run JOB through systemd, exactly as its timer would, and
                      show its log until it finishes. The run appears in status
                      and logs, and never overlaps another run of JOB. Ctrl-C
                      stops following, not the backup. --no-wait returns at once.
  run JOB             Run JOB directly in this terminal, outside systemd. The
                      systemd service uses this command itself.

Snapshots:
  snapshots JOB [restic snapshots options]
                      List the snapshots of JOB, oldest first. Options go to
                      restic snapshots, e.g. --compact, --latest 5 or --json.
  show JOB [SNAPSHOT] [PATH] [--tree]
                      Run ls -alh on a directory in a snapshot of JOB, or tree
                      on everything below it with --tree. SNAPSHOT is an ID
                      from snapshots, latest by default. PATH is an absolute
                      path in the snapshot. Without it, the backed-up paths
                      are shown. ls runs on a temporary FUSE mount.
  restore JOB [SNAPSHOT] [PATH] [--target DIR] [--overwrite MODE] [--delete]
          [--dry-run] [-y]
                      Put files from a snapshot of JOB back, in place or below
                      DIR, after showing what would change and asking. PATH
                      limits it to one folder or file. MODE: always (default)
                      overwrites files that differ, if-changed does so faster,
                      if-newer keeps newer files, never only adds missing
                      ones. --delete also removes files not in the snapshot.
  forget JOB --keep-last N | --older-than DURATION | --oldest N
             [--dry-run] [--prune | --no-prune] [-y]
                      List the snapshots of JOB to forget, ask, then forget
                      them. --keep-last N keeps the N newest. --older-than
                      DURATION (30d, 1y6m) forgets those more than DURATION
                      older than the newest. Together, a snapshot stays if
                      either keeps it. --oldest N forgets the N oldest. Their
                      data is pruned if the job's PRUNE setting is on.
                      --dry-run only lists them.

Other:
  help                Show this help
  version             Show the version

Every command is safe to re-run, except that each forget --oldest N forgets N
more. Files are rewritten only when their content changes, and systemd is
reloaded only when a unit file changed.
USAGE
}

main() {
  local arg
  local -a args=()
  # --system may go anywhere on the command line, e.g. "status --system".
  for arg in "$@"; do
    if [[ "$arg" == --system ]]; then set_scope system; else args+=("$arg"); fi
  done
  set -- "${args[@]}"
  local cmd=${1:-help}
  shift || true
  case $cmd in
    init)              cmd_init "$@" ;;
    add)               cmd_add "$@" ;;
    import)            cmd_import "$@" ;;
    list|ls)           cmd_list "$@" ;;
    install)           cmd_install "$@" ;;
    remove|rm)         cmd_remove "$@" ;;
    status)            cmd_status "$@" ;;
    logs|log)          cmd_logs "$@" ;;
    start)             cmd_start "$@" ;;
    run)               cmd_run "$@" ;;
    snapshots)         cmd_snapshots "$@" ;;
    show)              cmd_show "$@" ;;
    restore)           cmd_restore "$@" ;;
    forget)            cmd_forget "$@" ;;
    help|-h|--help)    usage ;;
    version|--version) echo "$PROG $VERSION" ;;
    *)                 die "unknown command '$cmd' (see '$PROG help')" ;;
  esac
}

# Run only when executed, so a test can source this file for its functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
